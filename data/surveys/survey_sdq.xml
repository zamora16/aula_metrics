<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===========================================================
         CUESTIONARIO SDQ — Strengths and Difficulties Questionnaire
         Versión Autoinforme (11–17 años)
         survey_code: SDQ | Edad recomendada: 11–17 años

         Cada ítem es una pregunta simple_choice con 3 opciones propias.
         sequence = número de ítem (1–25), usado por SdqScoring.
         Ítems inversos (7,11,14,21,25): score ya invertido en las opciones.
         =========================================================== -->

    <record id="survey_sdq" model="survey.survey">
        <field name="title">SDQ — Cuestionario de Capacidades y Dificultades (Autoinforme)</field>
        <field name="is_aulametrics" eval="True"/>
        <field name="survey_code">SDQ</field>
        <field name="recommended_age_min">11</field>
        <field name="recommended_age_max">17</field>
        <field name="description">Para cada frase, marca la casilla que mejor describa cómo te has comportado o sentido en los últimos 6 meses.</field>
        <field name="scoring_type">no_scoring</field>
        <field name="questions_layout">one_page</field>
        <field name="users_can_go_back" eval="True"/>
        <field name="is_attempts_limited" eval="False"/>
        <field name="is_time_limited" eval="False"/>
        <field name="access_mode">token</field>
        <field name="users_login_required" eval="False"/>
    </record>

    <!-- ÍTEM 1 — Prosocial -->
    <record id="sdq_q01" model="survey.question">
        <field name="survey_id" ref="survey_sdq"/>
        <field name="title">Tengo en cuenta los sentimientos de otras personas</field>
        <field name="question_type">simple_choice</field>
        <field name="sequence">1</field>
        <field name="metric_label">Conducta prosocial</field>
        <field name="constr_mandatory" eval="True"/>
    </record>
    <record id="sdq_q01_a0" model="survey.question.answer"><field name="question_id" ref="sdq_q01"/><field name="value">No es cierto</field><field name="score">0</field><field name="sequence">1</field></record>
    <record id="sdq_q01_a1" model="survey.question.answer"><field name="question_id" ref="sdq_q01"/><field name="value">Un tanto cierto</field><field name="score">1</field><field name="sequence">2</field></record>
    <record id="sdq_q01_a2" model="survey.question.answer"><field name="question_id" ref="sdq_q01"/><field name="value">Absolutamente cierto</field><field name="score">2</field><field name="sequence">3</field></record>

