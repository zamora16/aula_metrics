<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        noupdate="1": este registro se crea UNA SOLA VEZ al instalar el módulo.
        Las actualizaciones posteriores NO lo tocan, preservando el número actual
        de la secuencia y evitando duplicados en student_code.
    -->
    <data noupdate="1">
        <record id="seq_student_code" model="ir.sequence">
            <field name="name">Código de Alumno</field>
            <field name="code">aula_metrics.student_code</field>
            <field name="prefix">ALU-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
