# ==============================================================
#  SWLS — Escala de Satisfacción con la Vida
# ==============================================================

#. module: aula_metrics
#: model:survey.survey,title:aula_metrics.survey_swls
msgid "SWLS — Escala de Satisfacción con la Vida"
msgstr "SWLS — Escala de Satisfacció amb la Vida"

#. module: aula_metrics
#: model:survey.survey,description:aula_metrics.survey_swls
msgid "Por favor, indica tu grado de acuerdo con cada frase seleccionando el número apropiado."
msgstr "Per favor, indica el teu grau d'acord amb cada frase seleccionant el número apropiat."

#. module: aula_metrics
#: model:survey.question,title:aula_metrics.swls_matrix
msgid "Para cada una de las siguientes afirmaciones, indica tu grado de acuerdo."
msgstr "Per a cadascuna de les afirmacions següents, indica el teu grau d'acord."

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_col_1
msgid "Completamente en desacuerdo"
msgstr "Completament en desacord"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_col_2
msgid "En desacuerdo"
msgstr "En desacord"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_col_3
msgid "Más bien en desacuerdo"
msgstr "Més aviat en desacord"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_col_4
msgid "Ni de acuerdo ni en desacuerdo"
msgstr "Ni d'acord ni en desacord"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_col_5
msgid "Más bien de acuerdo"
msgstr "Més aviat d'acord"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_col_6
msgid "De acuerdo"
msgstr "D'acord"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_col_7
msgid "Completamente de acuerdo"
msgstr "Completament d'acord"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_row_1
msgid "En la mayoría de los aspectos mi vida es como yo quiero que sea"
msgstr "En la majoria dels aspectes la meua vida és com jo vull que siga"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_row_2
msgid "Las circunstancias de mi vida son muy buenas"
msgstr "Les circumstàncies de la meua vida són molt bones"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_row_3
msgid "Estoy satisfecho con mi vida"
msgstr "Estic satisfet/a amb la meua vida"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_row_4
msgid "Hasta ahora he conseguido de la vida las cosas que considero importantes"
msgstr "Fins ara he aconseguit de la vida les coses que considere importants"

#. module: aula_metrics
#: model:survey.question.answer,value:aula_metrics.swls_row_5
msgid "Si pudiera vivir mi vida otra vez no cambiaría casi nada"
msgstr "Si poguera viure la meua vida una altra vegada no canviaria quasi res"

