<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard de Alertas -->
    <record id="view_alerts_dashboard" model="ir.ui.view">
        <field name="name">aula_metrics.alerts.dashboard</field>
        <field name="model">aula_metrics.alerts_dashboard</field>
        <field name="arch" type="xml">
            <form string="Sistema de Alertas" create="false" edit="false">
                <div class="oe_title">
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                </div>
                <notebook>
                    <!-- Pestaña de Alertas Activas -->
                    <page string="Alertas Activas" name="active_alerts">
                        <div class="alert alert-info" role="alert">
                            <strong>Alertas activas:</strong> Las alertas se generan automáticamente según los umbrales configurados.
                        </div>
                        <field name="active_alerts" nolabel="1" mode="tree,form">
                            <tree string="Alertas Activas"
                                  decoration-success="severity == 'low' and status == 'active'"
                                  decoration-warning="severity == 'moderate' and status == 'active'"
                                  decoration-danger="severity == 'high' and status == 'active'"
                                  decoration-info="status == 'en_gestion'">
                                <field name="name"/>
                                <field name="alert_date"/>
                                <field name="alert_level"/>
                                <field name="severity"/>
                                <field name="status" widget="badge"
                                       decoration-success="status == 'active'"
                                       decoration-info="status == 'en_gestion'"/>
                                <field name="threshold_id"/>
                                <field name="student_id" groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor"/>
                                <field name="academic_group_id" groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_tutor"/>
                                <field name="education_level" groups="aula_metrics.group_aulametrics_management"/>
                                <field name="score_value"/>
                                <!-- case_id: campo auxiliar para condicionar botones; oculto en columna -->
                                <field name="case_id" column_invisible="1"/>
                                <!--
                                    RESOLVER: solo cuando NO hay caso (alertas grupales o individuales sin caso).
                                    Accesible a orientador, admin y tutor.
                                -->
                                <button name="action_resolve" string="Resolver" type="object"
                                        class="btn btn-success btn-sm"
                                        invisible="case_id"
                                        groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_tutor"/>
                                <!--
                                    VER CASO: solo cuando hay caso vinculado.
                                    Exclusivo de orientadores y admins (los que gestionan casos).
                                -->
                                <button name="action_open_case" string="Ver Caso" type="object"
                                        class="btn btn-primary btn-sm"
                                        invisible="not case_id"
                                        groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor"/>
                                <!--
                                    DESCARTAR: falso positivo; funciona en 'active' y 'en_gestion'.
                                    Accesible a orientador, admin y tutor.
                                -->
                                <button name="action_dismiss" string="Descartar" type="object"
                                        class="btn btn-warning btn-sm"
                                        confirm="¿Descartar esta alerta?"
                                        invisible="status not in ('active', 'en_gestion')"
                                        groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_tutor"/>
                            </tree>
                            <form string="Alerta">
                                <sheet>
                                    <field name="case_id" invisible="1"/>
                                    <group>
                                        <field name="name" readonly="1"/>
                                        <field name="alert_date" readonly="1"/>
                                        <field name="status" widget="badge"
                                               decoration-success="status == 'active'"
                                               decoration-info="status == 'en_gestion'"
                                               decoration-secondary="status in ('resolved', 'dismissed')"/>
                                        <field name="alert_level" readonly="1"/>
                                        <field name="severity" readonly="1"/>
                                        <field name="alert_type" readonly="1"/>
                                        <field name="threshold_id" readonly="1"
                                               invisible="alert_type != 'quantitative'"/>
                                    </group>
                                    <group>
                                        <field name="message" readonly="1"/>
                                        <field name="score_value" readonly="1"
                                               invisible="alert_type == 'manual'"/>
                                    </group>
                                    <group string="Origen">
                                        <field name="student_id" readonly="1"
                                               groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor"/>
                                        <field name="academic_group_id" readonly="1"/>
                                    </group>
                                    <group string="Descripción del Tutor" invisible="alert_type != 'manual'">
                                        <field name="manual_description" readonly="1" widget="text"
                                               nolabel="1" colspan="2"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>

                    <!-- Pestaña de Configuración de Umbrales -->
                    <page string="Umbrales Configurados" name="threshold_config">
                        <div class="alert alert-info" role="alert">
                            <strong>Umbrales Configurados:</strong> Umbrales que activarán alertas automáticamente (solo lectura).
                        </div>
                        <field name="thresholds" nolabel="1" mode="tree,form" context="{'create': False, 'edit': False, 'delete': False}">
                            <tree string="Umbrales Configurados" create="false" edit="false" delete="false">
                                <field name="name"/>
                                <field name="score_field"/>
                                <field name="threshold_value"/>
                                <field name="operator"/>
                                <field name="severity"/>
                                <field name="group_threshold_percentage" string="% Grupal"/>
                            </tree>
                            <form string="Umbral" create="false" edit="false" delete="false">
                                <group>
                                    <field name="name" readonly="1"/>
                                    <field name="score_field" readonly="1"/>
                                    <field name="operator" readonly="1"/>
                                    <field name="threshold_value" readonly="1"/>
                                    <field name="severity" readonly="1"/>
                                    <field name="group_threshold_percentage" readonly="1"/>
                                </group>
                                <group>
                                    <field name="alert_message" readonly="1" placeholder="Mensaje que aparecerá en las alertas..."/>
                                </group>
                            </form>
                        </field>
                    </page>

                    <!-- Pestaña de Historial -->
                    <page string="Historial de Alertas" name="alert_history">
                        <div class="alert alert-info" role="alert">
                            <strong>Historial:</strong> Todas las alertas generadas (resueltas, descartadas, etc.).
                        </div>
                        <field name="all_alerts" nolabel="1" mode="tree,form">
                            <tree string="Historial Completo" create="false" edit="false" delete="false">
                                <field name="name"/>
                                <field name="alert_date"/>
                                <field name="status"/>
                                <field name="alert_level"/>
                                <field name="threshold_id"/>
                                <field name="academic_group_id" groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_tutor"/>
                                <field name="education_level" groups="aula_metrics.group_aulametrics_management"/>
                            </tree>
                            <form string="Alerta">
                                <group>
                                    <field name="name" readonly="1"/>
                                    <field name="alert_date" readonly="1"/>
                                    <field name="status"/>
                                    <field name="alert_level" readonly="1"/>
                                    <field name="severity" readonly="1"/>
                                    <field name="threshold_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="message" readonly="1"/>
                                    <field name="score_value" readonly="1"/>
                                </group>
                                <group>
                                    <field name="participation_id" readonly="1"/>
                                    <field name="student_id" readonly="1" groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor"/>
                                    <field name="academic_group_id" readonly="1"/>
                                </group>
                                <group string="Resolución" invisible="status != 'resolved'">
                                    <field name="resolution_date" readonly="1"/>
                                    <field name="resolution_action" readonly="1" widget="text" colspan="2"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <!-- Acción del Dashboard -->
    <record id="action_alerts_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard de Alertas</field>
        <field name="res_model">aula_metrics.alerts_dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_alerts_dashboard"/>
        <field name="target">current</field>
        <field name="res_id" ref="alerts_dashboard_main"/>
        <field name="domain">[]</field>
        <field name="context">{'create': False, 'edit': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bienvenido al Sistema de Alertas
            </p>
            <p>
                Aquí puedes configurar umbrales para alertas automáticas y gestionar las alertas activas.
            </p>
        </field>
    </record>
</odoo>