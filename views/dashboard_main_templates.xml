<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         SIDEBAR DE NAVEGACIÓN
         Variables requeridas: role_info (dict), active_section (str)
         ===================================================================== -->
    <template id="dashboard_sidebar" name="AulaMetrics - Sidebar">
        <aside class="sidebar">
            <div class="sidebar-header">
                <img src="/aula_metrics/static/src/img/Logo_1024.png"
                     alt="AulaMetrics"
                     style="max-width:180px;height:auto;display:block;margin:0 auto;"/>
            </div>
            <nav class="sidebar-nav">
                <!-- Dashboard interno: navegación JS; resto: enlaces href -->
                <t t-if="active_section in ('home', 'quantitative', 'qualitative', 'segmentation')">
                    <a href="#"
                       t-att-class="'sidebar-item active' if active_section == 'home' else 'sidebar-item'"
                       t-att-aria-current="'page' if active_section == 'home' else False"
                       data-section="home"
                       onclick="navigateTo('home'); return false;">
                        <i class="fa-solid fa-house" aria-hidden="true"/>
                        <span>Inicio</span>
                    </a>
                    <a href="#"
                       t-att-class="'sidebar-item active' if active_section == 'quantitative' else 'sidebar-item'"
                       t-att-aria-current="'page' if active_section == 'quantitative' else False"
                       data-section="quantitative"
                       onclick="navigateTo('quantitative'); return false;">
                        <i class="fa-solid fa-chart-line" aria-hidden="true"/>
                        <span>Datos Cuantitativos</span>
                    </a>
                    <a href="#"
                       t-att-class="'sidebar-item active' if active_section == 'qualitative' else 'sidebar-item'"
                       t-att-aria-current="'page' if active_section == 'qualitative' else False"
                       data-section="qualitative"
                       onclick="navigateTo('qualitative'); return false;">
                        <i class="fa-solid fa-comments" aria-hidden="true"/>
                        <span>Datos Cualitativos</span>
                    </a>
                    <a href="#"
                       t-att-class="'sidebar-item active' if active_section == 'segmentation' else 'sidebar-item'"
                       t-att-aria-current="'page' if active_section == 'segmentation' else False"
                       data-section="segmentation"
                       onclick="navigateTo('segmentation'); return false;">
                        <i class="fa-solid fa-chart-pie" aria-hidden="true"/>
                        <span>Distribución</span>
                    </a>
                </t>
                <t t-else="">
                    <a href="/aulametrics/dashboard?section=home" class="sidebar-item">
                        <i class="fa-solid fa-house" aria-hidden="true"/>
                        <span>Inicio</span>
                    </a>
                    <a href="/aulametrics/dashboard?section=quantitative" class="sidebar-item">
                        <i class="fa-solid fa-chart-line" aria-hidden="true"/>
                        <span>Datos Cuantitativos</span>
                    </a>
                    <a href="/aulametrics/dashboard?section=qualitative" class="sidebar-item">
                        <i class="fa-solid fa-comments" aria-hidden="true"/>
                        <span>Datos Cualitativos</span>
                    </a>
                    <a href="/aulametrics/dashboard?section=segmentation" class="sidebar-item">
                        <i class="fa-solid fa-chart-pie" aria-hidden="true"/>
                        <span>Distribución</span>
                    </a>
                </t>
                <!-- Perfiles: solo counselor/admin -->
                <t t-if="role_info and role_info.get('role') in ('admin', 'counselor')">
                    <a href="/aulametrics/students"
                       t-att-class="'sidebar-item active' if active_section == 'profiles' else 'sidebar-item'"
                       t-att-aria-current="'page' if active_section == 'profiles' else False">
                        <i class="fa-solid fa-users" aria-hidden="true"/>
                        <span>Perfiles de Alumnos</span>
                    </a>
                </t>
            </nav>
            <div class="sidebar-footer">
                <t t-if="role_info and role_info.get('user_name')">
                    <div style="margin-bottom:10px;padding:8px 10px;background:rgba(255,255,255,0.07);border-radius:8px;">
                        <div style="font-size:12px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" t-out="role_info.get('user_name')"/>
                        <div style="font-size:10px;margin-top:2px;">
                            <t t-if="role_info.get('role') == 'admin'">
                                <span style="color:#fca5a5;"><i class="fa-solid fa-shield-halved me-1" aria-hidden="true"/>Administrador</span>
                            </t>
                            <t t-elif="role_info.get('role') == 'counselor'">
                                <span style="color:#93c5fd;"><i class="fa-solid fa-user-tie me-1" aria-hidden="true"/>Orientador/a</span>
                            </t>
                            <t t-elif="role_info.get('role') == 'management'">
                                <span style="color:#fde68a;"><i class="fa-solid fa-briefcase me-1" aria-hidden="true"/>Equipo Directivo</span>
                            </t>
                            <t t-else="">
                                <span style="color:#86efac;"><i class="fa-solid fa-chalkboard-user me-1" aria-hidden="true"/>Tutor/a</span>
                            </t>
                        </div>
                    </div>
                </t>
                <a href="/web" class="btn btn-outline-light btn-sm w-100">
                    <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"/>Volver a Odoo
                </a>
            </div>
        </aside>
    </template>


    <!-- =====================================================================
         TOPBAR
         Variables requeridas: topbar_title (str), role_info (dict)
         Opcionales: topbar_subtitle (str|Markup), topbar_extra_actions (Markup)
         ===================================================================== -->
    <template id="dashboard_topbar" name="AulaMetrics - Topbar">
        <t t-set="role_" t-value="(role_info or {}).get('role', 'tutor')"/>
        <div class="topbar">
            <div>
                <h3 id="sectionTitle"><t t-out="topbar_title"/></h3>
                <t t-if="topbar_subtitle">
                    <span class="breadcrumbs"><t t-out="topbar_subtitle"/></span>
                </t>
            </div>
            <div class="topbar-actions">
                <t t-if="topbar_extra_actions">
                    <t t-out="topbar_extra_actions"/>
                </t>
            </div>
        </div>
    </template>


    <!-- =====================================================================
         SECCIÓN HOME
         Variables: home_evaluations (list[dict]), home_kpi_active (int),
                    home_kpi_scheduled (int), home_kpi_closed (int),
                    home_kpi_avg_all (str|None), home_kpi_avg_active (str|None),
                    home_kpi_alerts (int), role_info (dict)
         ===================================================================== -->
    <template id="dashboard_home_section" name="AulaMetrics - Sección Inicio">
        <div class="home-section">

            <!-- ── Banner de bienvenida ── -->
            <div class="welcome-banner">
                <div class="welcome-banner-icon" aria-hidden="true">
                    <i class="fa-solid fa-chart-line"/>
                </div>
                <div class="welcome-banner-body">
                    <h2>Dashboard AulaMetrics</h2>
                    <p>Seguimiento del bienestar psicosocial del alumnado</p>
                </div>
            </div>

            <!-- ── KPIs agregados ── -->
            <div class="quick-stats-container">

                <!-- Evaluaciones: total con desglose por estado -->
                <div class="stat-card">
                    <div class="stat-icon blue">
                        <i class="fa-solid fa-clipboard-check" aria-hidden="true"/>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Evaluaciones</div>
                        <div class="stat-value">
                            <t t-out="(home_kpi_active or 0) + (home_kpi_scheduled or 0) + (home_kpi_closed or 0)"/>
                        </div>
                        <div class="stat-meta">
                            <t t-if="home_kpi_active">
                                <span class="stat-meta-dot active"><t t-out="home_kpi_active"/> activa<t t-if="home_kpi_active != 1">s</t></span>
                            </t>
                            <t t-if="home_kpi_scheduled">
                                <span class="stat-meta-dot scheduled"><t t-out="home_kpi_scheduled"/> prog.</span>
                            </t>
                            <t t-if="home_kpi_closed">
                                <span class="stat-meta-dot closed"><t t-out="home_kpi_closed"/> cerrada<t t-if="home_kpi_closed != 1">s</t></span>
                            </t>
                            <t t-if="not home_kpi_active and not home_kpi_scheduled and not home_kpi_closed">
                                <span class="stat-meta-empty">Ninguna todavía</span>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Participación media global -->
                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="fa-solid fa-chart-line" aria-hidden="true"/>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Participación media</div>
                        <div class="stat-value">
                            <t t-if="home_kpi_avg_all"><t t-out="home_kpi_avg_all"/></t>
                            <t t-else=""><span style="font-size:20px;color:var(--am-muted);">—</span></t>
                        </div>
                    </div>
                </div>

                <!-- Participación activas (solo si hay alguna activa) -->
                <t t-if="home_kpi_active and home_kpi_avg_active">
                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <i class="fa-solid fa-bolt" aria-hidden="true"/>
                        </div>
                        <div class="stat-content">
                            <div class="stat-label">Part. evaluaciones activas</div>
                            <div class="stat-value"><t t-out="home_kpi_avg_active"/></div>
                            <div class="stat-meta">
                                <span class="stat-meta-empty">En curso ahora</span>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Alertas activas -->
                <div class="stat-card">
                    <div t-att-class="'stat-icon ' + ('red' if home_kpi_alerts else 'green')">
                        <i t-att-class="'fa-solid ' + ('fa-bell' if home_kpi_alerts else 'fa-bell-slash')" aria-hidden="true"/>
                    </div>
                    <div class="stat-content">
                        <div class="stat-label">Alertas activas</div>
                        <div class="stat-value"><t t-out="home_kpi_alerts or 0"/></div>
                        <div class="stat-meta">
                            <t t-if="not home_kpi_alerts">
                                <span class="stat-meta-empty">Sin alertas pendientes</span>
                            </t>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ── Grid de evaluaciones ── -->
            <div class="evaluations-section">
                <div class="section-header">
                    <h3 class="section-title">Evaluaciones</h3>
                </div>

                <t t-if="home_evaluations">
                    <div class="evaluations-grid">
                        <t t-foreach="home_evaluations" t-as="ev">
                            <div t-att-class="'evaluation-card eval-state-' + ev['state']">

                                <!-- Cabecera: estado + nombre -->
                                <div class="evaluation-card-header">
                                    <span t-att-class="'eval-state-badge ' + ev['state_css']">
                                        <t t-out="ev['state_label']"/>
                                    </span>
                                    <h4 class="evaluation-card-title">
                                        <t t-out="ev['name']"/>
                                    </h4>
                                </div>

                                <!-- Cuerpo: fechas, grupos, cuestionarios -->
                                <div class="evaluation-card-body">
                                    <div class="evaluation-info-item">
                                        <i class="fa-solid fa-calendar-days" aria-hidden="true"/>
                                        <span class="evaluation-info-value"><t t-out="ev['date_range']"/></span>
                                    </div>
                                    <div class="evaluation-info-item">
                                        <i class="fa-solid fa-users" aria-hidden="true"/>
                                        <span class="evaluation-info-value"><t t-out="ev['groups']"/></span>
                                    </div>
                                    <div class="evaluation-info-item">
                                        <i class="fa-solid fa-clipboard" aria-hidden="true"/>
                                        <span class="evaluation-info-value"><t t-out="ev['surveys']"/></span>
                                    </div>
                                </div>

                                <!-- Pie: barra de progreso de participación -->
                                <div class="evaluation-card-footer">
                                    <div class="eval-progress-header">
                                        <span>Participación</span>
                                        <span t-att-class="'eval-progress-pct participation-badge ' + ev.get('participation_class', '')">
                                            <t t-out="ev['participation_pct']"/>%
                                            (<t t-out="ev['completed_students']"/>/<t t-out="ev['total_students']"/>)
                                        </span>
                                    </div>
                                    <div class="eval-progress-track" role="progressbar"
                                         t-att-aria-valuenow="ev['participation_pct']"
                                         aria-valuemin="0" aria-valuemax="100">
                                        <div t-att-class="'eval-progress-fill ' + ev.get('participation_class', 'low')"
                                             t-att-style="'width:' + str(ev['participation_pct']) + '%'"/>
                                    </div>
                                    <t t-if="ev.get('report_url')">
                                        <a t-att-href="ev['report_url']"
                                           class="eval-report-link mt-2"
                                           title="Ver informe de resultados">
                                            <i class="fa-solid fa-chart-bar me-1"/>Ver informe
                                        </a>
                                    </t>
                                </div>

                            </div>
                        </t>
                    </div>
                </t>

                <t t-else="">
                    <div class="empty-evaluations">
                        <i class="fa-solid fa-clipboard-question" aria-hidden="true"/>
                        <h3>No hay evaluaciones registradas</h3>
                        <p>Las evaluaciones que crees aparecerán aquí con su estado y progreso.</p>
                    </div>
                </t>
            </div>

        </div>
    </template>


    <!-- =====================================================================
         CONTROLES DE FILTRO
         Variables: available_evaluations (list[dict]), selected_evals (list[int])
         ===================================================================== -->
    <template id="dashboard_filter_controls" name="AulaMetrics - Controles de Filtro">
        <div class="filter-panel-compact">
            <form id="hub-filters" method="get" action="/aulametrics/dashboard">
                <div class="filter-header">
                    <i class="fa-solid fa-filter" aria-hidden="true"/>
                    <span>Filtrar por Evaluaciones</span>
                </div>
                <div class="filter-pills-container" role="group" aria-label="Filtrar por evaluación">
                    <t t-foreach="available_evaluations or []" t-as="ev">
                        <t t-set="is_active" t-value="(selected_evals and ev['id'] in selected_evals) or not selected_evals"/>
                        <button type="button"
                                t-att-class="'filter-pill eval-pill' + (' active' if is_active else '')"
                                role="checkbox"
                                t-att-aria-checked="'true' if is_active else 'false'"
                                data-type="eval"
                                t-att-data-value="ev['id']"
                                onclick="togglePill(this)">
                            <t t-out="ev['name']"/>
                        </button>
                    </t>
                </div>
                <div class="filter-actions">
                    <button type="button" class="btn-filter-action" onclick="selectAllEvals()">
                        <i class="fa-solid fa-check-double me-1" aria-hidden="true"/>Todas
                    </button>
                    <button type="submit" class="btn-filter-action btn-filter-primary">
                        <i class="fa-solid fa-magnifying-glass me-1" aria-hidden="true"/>Aplicar Filtros
                    </button>
                </div>
            </form>
        </div>
    </template>


    <!-- =====================================================================
         KPI CARDS
         Variables: kpi_students, kpi_groups, kpi_evals, kpi_metrics (int)
         ===================================================================== -->
    <template id="dashboard_kpis" name="AulaMetrics - KPI Cards">
        <div class="kpi-card">
            <div class="kpi-label">Estudiantes</div>
            <div class="kpi-value"><t t-out="kpi_students or 0"/></div>
            <div class="kpi-description">Total analizados</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Grupos</div>
            <div class="kpi-value"><t t-out="kpi_groups or 0"/></div>
            <div class="kpi-description">Académicos</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Evaluaciones</div>
            <div class="kpi-value"><t t-out="kpi_evals or 0"/></div>
            <div class="kpi-description">En el dashboard</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Participación media</div>
            <div class="kpi-value"><t t-out="(str(kpi_participation) + '%') if kpi_participation is not None else '—'"/></div>
            <div class="kpi-description">Promedio de evaluaciones</div>
        </div>
    </template>


    <!-- =====================================================================
         SCRIPTS JAVASCRIPT DEL DASHBOARD (sin datos en tiempo de render)
         ===================================================================== -->
    <template id="dashboard_scripts" name="AulaMetrics - Scripts JavaScript">
        <script src="/aula_metrics/static/src/js/am_dashboard.js"/>
    </template>



    <!-- =====================================================================
         PÁGINA PRINCIPAL DEL DASHBOARD (plantilla raíz)
         Variables: head_extra (Markup), css_styles (Markup),
                    role_info (dict), active_section (str),
                    topbar_title (str), topbar_subtitle (Markup),
                    available_evaluations (list), selected_evals (list),
                    charts (list[Markup]), kpi_* (int),
                    home_* (varios)
         ===================================================================== -->
    <template id="dashboard_main" name="AulaMetrics - Página Principal del Dashboard">
        <html lang="es">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Dashboard de Métricas - AulaMetrics</title>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
                      rel="stylesheet"/>
                <t t-out="head_extra"/>
                <t t-out="css_styles"/>
            </head>
            <body>
                <div class="dashboard-layout">
                    <t t-call="aula_metrics.dashboard_sidebar"/>
                    <main class="main-content">
                        <t t-call="aula_metrics.dashboard_topbar"/>
                        <div class="content-wrapper">

                            <!-- Sección Inicio -->
                            <div class="content-section active" id="section-home">
                                <t t-call="aula_metrics.dashboard_home_section"/>
                            </div>

                            <!-- Sección Datos Cuantitativos -->
                            <div class="content-section" id="section-quantitative">
                                <div class="container-fluid">
                                    <t t-call="aula_metrics.dashboard_filter_controls"/>
                                    <t t-if="charts">
                                        <div class="kpi-container my-4">
                                            <t t-call="aula_metrics.dashboard_kpis"/>
                                        </div>
                                        <div class="charts-container">
                                            <t t-foreach="charts" t-as="chart">
                                                <t t-out="chart"/>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="empty-state mt-4">
                                            <i class="fa-solid fa-chart-line fa-4x"/>
                                            <h3>No hay datos disponibles</h3>
                                            <p>Ajusta los filtros para ver resultados</p>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Sección Datos Cualitativos -->
                            <div class="content-section" id="section-qualitative">
                                <div id="qualitativeContent">
                                    <div style="text-align:center;padding:60px 20px;">
                                        <i class="fa-solid fa-spinner fa-spin"
                                           style="font-size:48px;color:var(--am-primary);"/>
                                        <p style="margin-top:20px;color:var(--am-muted);">
                                            Cargando datos cualitativos...
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Sección Distribución del Alumnado -->
                            <div class="content-section" id="section-segmentation">
                                <div id="segmentationContent">
                                    <div style="text-align:center;padding:60px 20px;">
                                        <i class="fa-solid fa-spinner fa-spin"
                                           style="font-size:48px;color:var(--am-primary);"/>
                                        <p style="margin-top:20px;color:var(--am-muted);">
                                            Cargando distribución del alumnado...
                                        </p>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </main>
                </div>
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"/>
                <t t-call="aula_metrics.dashboard_scripts"/>
            </body>
        </html>
    </template>

</odoo>
