<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         HEAD COMPARTIDO — paleta, tipografía y CSS del portal
         ============================================================ -->
    <template id="portal_head" name="Portal Head AulaMetrics">
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <meta name="robots" content="noindex,nofollow"/>
        <link rel="icon" type="image/png" href="/aula_metrics/static/src/img/favicon.png"/>
        <!-- Tipografía unificada con el dashboard: Playfair Display + Source Sans 3 -->
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
        <link rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&amp;family=Source+Sans+3:wght@400;500;600&amp;display=swap"/>
        <!-- Hoja de estilos del portal: paleta Warm Teal Scholarly del dashboard -->
        <link rel="stylesheet" type="text/css" href="/aula_metrics/static/src/css/portal.css?v=3"/>
    </template>


    <!-- ============================================================
         SELECTOR DE IDIOMA — widget reutilizable
         Espera en contexto: `active_lang` (código activo), `supported_langs` (dict),
         `_lang_base_url` (URL de la página actual, sin parámetros).
         Envía POST a /am/lang para fijar la cookie sin añadir ?lang= a la URL
         (evita que el módulo website de Odoo intercepte el parámetro y redirija).
         ============================================================ -->
    <template id="portal_lang_switcher" name="Selector de Idioma Portal">
        <div class="am-lang-switcher" aria-label="Seleccionar idioma">
            <t t-foreach="supported_langs.items()" t-as="lang_item">
                <form method="post" action="/am/lang">
                    <input type="hidden" name="lang" t-att-value="lang_item[0]"/>
                    <input type="hidden" name="redirect" t-att-value="_lang_base_url"/>
                    <button type="submit"
                            t-att-class="'active' if lang_item[0] == active_lang else ''"
                            t-att-aria-current="'true' if lang_item[0] == active_lang else None"
                            t-att-title="lang_item[1]">
                        <t t-out="lang_item[1]"/>
                    </button>
                </form>
            </t>
        </div>
    </template>


    <!-- ============================================================
         TOPBAR DEL PORTAL — logo del centro + selector de idioma
         Variables requeridas: las mismas que portal_lang_switcher
         (_lang_base_url, active_lang, supported_langs).
         El lang switcher usa posición estática dentro del topbar
         (el CSS de .am-topbar .am-lang-switcher anula el position:fixed).
         ============================================================ -->
    <template id="portal_topbar" name="Portal Topbar AulaMetrics">
        <t t-set="am_company" t-value="env.company"/>
        <header class="am-topbar" role="banner">
            <div class="am-topbar-logo">
                <t t-if="am_company.logo">
                    <img t-att-src="'/web/image/res.company/' + str(am_company.id) + '/logo'"
                         t-att-alt="am_company.name"/>
                </t>
            </div>
            <t t-call="aula_metrics.portal_lang_switcher"/>
        </header>
    </template>


    <!-- ============================================================
         PORTAL DE EVALUACIÓN — lista de encuestas
         ============================================================ -->
    <template id="portal_evaluacion" name="Portal de Evaluación AulaMetrics">
        <html>
            <head>
                <t t-call="aula_metrics.portal_head"/>
                <title>Evaluación - AulaMetrics</title>
            </head>
            <body>
                <!-- Topbar: logo del centro + selector de idioma -->
                <t t-call="aula_metrics.portal_topbar">
                    <t t-set="_lang_base_url" t-value="'/evaluacion/' + token"/>
                </t>

                <div class="am-container">

                    <!-- Mensajes flash -->
                    <t t-if="request.params.get('msg') == 'guardado'">
                        <div class="am-alert am-alert-success">&#10003; Respuestas guardadas correctamente</div>
                    </t>

                    <!-- Cabecera de la evaluación -->
                    <div class="am-card am-header">
                        <h1><t t-out="evaluation.name"/></h1>
                        <p>Completa las siguientes encuestas</p>

                        <div class="am-info">
                            <div class="am-info-item">
                                <span class="label">Estudiante</span>
                                <span class="value"><t t-out="student.name"/></span>
                            </div>
                            <div class="am-info-item">
                                <span class="label">Progreso</span>
                                <span class="value">
                                    <t t-out="completed_count"/> / <t t-out="total_count"/> completadas
                                </span>
                            </div>
                            <t t-if="evaluation.date_end">
                                <div class="am-info-item">
                                    <span class="label">Fecha límite</span>
                                    <span class="value">
                                        <t t-out="evaluation.date_end" t-options="{'widget': 'date'}"/>
                                    </span>
                                </div>
                            </t>
                        </div>

                        <div class="am-progress-bar">
                            <div class="am-progress-fill" t-attf-style="width: #{progress}%"></div>
                        </div>
                    </div>

                    <!-- Evaluación 100% completada -->
                    <t t-if="progress == 100">
                        <div class="am-card am-complete-box">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                <polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                            <h2>&#161;Evaluación completada!</h2>
                            <p>Has respondido todas las encuestas. Gracias por participar.</p>
                        </div>
                    </t>

                    <!-- Lista de encuestas -->
                    <ul class="am-survey-list">
                        <t t-foreach="surveys" t-as="item">
                            <li t-attf-class="am-survey-item #{item['completed'] and 'completed' or ''}">
                                <span class="am-survey-title"><t t-out="item['survey'].title"/></span>
                                <t t-if="item['completed']">
                                    <span class="am-badge am-badge-success">&#10003; Completada</span>
                                </t>
                                <t t-else="">
                                    <a t-attf-href="/evaluacion/#{token}/encuesta/#{item['survey'].id}"
                                       class="am-btn am-btn-primary">
                                        Responder
                                    </a>
                                </t>
                            </li>
                        </t>
                    </ul>

                </div>
            </body>
        </html>
    </template>


    <!-- ============================================================
         FORMULARIO DE ENCUESTA
         ============================================================ -->
    <template id="portal_survey_form" name="Formulario de Encuesta">
        <html>
            <head>
                <t t-call="aula_metrics.portal_head"/>
                <title><t t-out="survey.title"/> - AulaMetrics</title>
            </head>
            <body>
                <!-- Topbar: logo del centro + selector de idioma -->
                <t t-if="preview">
                    <t t-call="aula_metrics.portal_topbar">
                        <t t-set="_lang_base_url" t-value="'/survey/preview/' + str(survey.id)"/>
                    </t>
                </t>
                <t t-else="">
                    <t t-call="aula_metrics.portal_topbar">
                        <t t-set="_lang_base_url" t-value="'/evaluacion/' + token + '/encuesta/' + str(survey.id)"/>
                    </t>
                </t>

                <div class="sf-container">

                    <!-- Navegación superior -->
                    <t t-if="not preview">
                        <a t-attf-href="/evaluacion/#{token}" class="sf-back">&#8592; Volver a la evaluación</a>
                    </t>
                    <t t-if="preview">
                        <a href="#" onclick="window.close()" class="sf-back">&#8592; Cerrar vista previa</a>
                    </t>

                    <!-- Cabecera de la encuesta -->
                    <div class="sf-header">
                        <h1><t t-out="survey.title"/></h1>
                        <t t-if="survey.description">
                            <p><t t-out="survey.description"/></p>
                        </t>
                    </div>

                    <!-- Formulario de preguntas -->
                    <form class="sf-form"
                          t-attf-action="/evaluacion/#{token}/encuesta/#{survey.id}/submit"
                          method="post">

                        <t t-foreach="questions" t-as="q">

                            <!-- Título de página/sección -->
                            <t t-if="q['type'] == 'page'">
                                <h2 class="sf-page-title"><t t-out="q['title']"/></h2>
                            </t>

                            <!-- Preguntas -->
                            <t t-if="q['type'] == 'question'">
                                <div class="sf-question">
                                    <div class="sf-question-title">
                                        <t t-out="q['title']"/>
                                        <t t-if="q['constr_mandatory']">
                                            <span class="required">*</span>
                                        </t>
                                    </div>

                                    <!-- Texto largo -->
                                    <t t-if="q['question_type'] == 'text_box'">
                                        <textarea class="sf-input"
                                                  t-attf-name="question_#{q['id']}"
                                                  t-att-required="q['constr_mandatory']"
                                                  placeholder="Escribe tu respuesta aquí..."></textarea>
                                    </t>

                                    <!-- Texto corto -->
                                    <t t-if="q['question_type'] == 'char_box'">
                                        <input type="text" class="sf-input"
                                               t-attf-name="question_#{q['id']}"
                                               t-att-required="q['constr_mandatory']"
                                               placeholder="Escribe tu respuesta..."/>
                                    </t>

                                    <!-- Numérico -->
                                    <t t-if="q['question_type'] == 'numerical_box'">
                                        <input type="number" class="sf-input"
                                               t-attf-name="question_#{q['id']}"
                                               t-att-required="q['constr_mandatory']"
                                               placeholder="Ingresa un número..."/>
                                    </t>

                                    <!-- Fecha -->
                                    <t t-if="q['question_type'] == 'date'">
                                        <input type="date" class="sf-input"
                                               t-attf-name="question_#{q['id']}"
                                               t-att-required="q['constr_mandatory']"/>
                                    </t>

                                    <!-- Fecha y hora -->
                                    <t t-if="q['question_type'] == 'datetime'">
                                        <input type="datetime-local" class="sf-input"
                                               t-attf-name="question_#{q['id']}"
                                               t-att-required="q['constr_mandatory']"/>
                                    </t>

                                    <!-- Selección simple (radio) -->
                                    <t t-if="q['question_type'] == 'simple_choice'">
                                        <div class="sf-options">
                                            <t t-foreach="q['suggested_answer_ids']" t-as="answer">
                                                <label class="sf-option">
                                                    <input type="radio"
                                                           t-attf-name="question_#{q['id']}"
                                                           t-att-value="answer.id"
                                                           t-att-required="q['constr_mandatory']"/>
                                                    <span><t t-out="answer.value"/></span>
                                                </label>
                                            </t>
                                        </div>
                                    </t>

                                    <!-- Selección múltiple (checkbox) -->
                                    <t t-if="q['question_type'] == 'multiple_choice'">
                                        <div class="sf-options">
                                            <t t-foreach="q['suggested_answer_ids']" t-as="answer">
                                                <label class="sf-option">
                                                    <input type="checkbox"
                                                           t-attf-name="question_#{q['id']}_answer_#{answer.id}"
                                                           t-att-value="answer.id"/>
                                                    <span><t t-out="answer.value"/></span>
                                                </label>
                                            </t>
                                        </div>
                                    </t>

                                    <!-- Matriz -->
                                    <t t-if="q['question_type'] == 'matrix'">
                                        <div class="sf-matrix-wrap">
                                            <table class="sf-matrix">
                                                <thead>
                                                    <tr>
                                                        <th></th>
                                                        <t t-foreach="q['suggested_answer_ids']" t-as="col">
                                                            <th><t t-out="col.value"/></th>
                                                        </t>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="q['matrix_row_ids']" t-as="row">
                                                        <tr>
                                                            <td><t t-out="row.value"/></td>
                                                            <t t-foreach="q['suggested_answer_ids']" t-as="col">
                                                                <td>
                                                                    <input type="radio"
                                                                           t-attf-name="question_#{q['id']}_row_#{row.id}"
                                                                           t-att-value="col.id"
                                                                           t-att-required="q['constr_mandatory']"/>
                                                                </td>
                                                            </t>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>

                                </div>
                            </t>
                        </t>

                        <!-- Acciones -->
                        <t t-if="not preview">
                            <div class="sf-actions">
                                <a t-attf-href="/evaluacion/#{token}" class="sf-back" style="margin:0">
                                    Cancelar
                                </a>
                                <button type="submit" class="sf-btn sf-btn-submit">
                                    Enviar respuestas
                                </button>
                            </div>
                        </t>
                        <t t-if="preview">
                            <div class="sf-preview-notice">
                                <p><em>Modo vista previa — No se pueden enviar respuestas</em></p>
                            </div>
                        </t>

                    </form>
                </div>
            </body>
        </html>
    </template>


    <!-- ============================================================
         PÁGINA DE ERROR
         ============================================================ -->
    <template id="portal_error" name="Error Portal AulaMetrics">
        <html>
            <head>
                <t t-call="aula_metrics.portal_head"/>
                <title>Error - AulaMetrics</title>
            </head>
            <body>
                <div class="am-error-page">
                    <div class="am-error-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        <h3><t t-out="error_title"/></h3>
                        <p><t t-out="error_message"/></p>
                    </div>
                </div>
            </body>
        </html>
    </template>

</odoo>
