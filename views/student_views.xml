<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista de Alumnos -->
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">aula_metrics.student.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Alumnos"
                  editable="top"
                  decoration-muted="not academic_group_id">
                <field name="student_firstname" string="Nombre"/>
                <field name="student_lastname" string="Apellidos"/>
                <field name="name" invisible="1"/>
                <field name="gender" string="Género"/>
                <field name="academic_group_id"
                       string="Grupo"
                       options="{'no_create': True}"
                       domain="[('active', '=', True)]"/>
                <field name="email" string="Email"/>
                <field name="birthdate" string="F. Nacimiento"/>
            </tree>
        </field>
    </record>

    <!-- Vista de Formulario de Alumno -->
    <record id="view_student_form" model="ir.ui.view">
        <field name="name">aula_metrics.student.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Alumno">
                <sheet>
                    <field name="image_1920" widget="image"
                           class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="student_lastname" string="Apellidos"/>
                        <h1>
                            <field name="student_lastname"
                                   placeholder="Apellidos del alumno"/>
                        </h1>
                        <label for="student_firstname" string="Nombre"/>
                        <h2 class="mt-0">
                            <field name="student_firstname"
                                   placeholder="Nombre del alumno"/>
                        </h2>
                        <!-- name se construye automáticamente vía onchange -->
                        <field name="name" invisible="1"/>
                    </div>
                    <group>
                        <group string="Datos Académicos">
                            <field name="academic_group_id"
                                   options="{'no_create': True}"
                                   domain="[('active', '=', True)]"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Datos Personales">
                            <field name="gender"/>
                            <field name="birthdate"/>
                            <field name="age" string="Edad actual" readonly="1" invisible="not birthdate"/>
                        </group>
                    </group>
                    <group>
                        <group string="Contacto">
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda de Alumnos -->
    <record id="view_student_search" model="ir.ui.view">
        <field name="name">aula_metrics.student.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Buscar Alumnos">
                <field name="name" string="Nombre"/>
                <field name="student_code" string="Código"/>
                <field name="academic_group_id" string="Grupo"/>
                <filter string="Todos los alumnos" name="all_students"
                        domain="[('academic_group_id', '!=', False)]"/>
                <filter string="Sin grupo asignado" name="no_group"
                        domain="[('student_code', '!=', False), ('academic_group_id', '=', False)]"/>
                <separator/>
                <filter string="ESO" name="eso"
                        domain="[('academic_group_id.course_level', 'in', ['eso1','eso2','eso3','eso4'])]"/>
                <filter string="Bachillerato" name="bach"
                        domain="[('academic_group_id.course_level', 'in', ['bach1','bach2'])]"/>
                <separator/>
                <filter string="Activos" name="active_students" domain="[('active', '=', True)]"/>
                <filter string="Archivados" name="archived_students" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Grupo" name="by_group" context="{'group_by': 'academic_group_id'}"/>
                    <filter string="Género" name="by_gender" context="{'group_by': 'gender'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_student_list" model="ir.actions.act_window">
        <field name="name">Alumnos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_student_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_student_form')})]"/>
        <field name="search_view_id" ref="view_student_search"/>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="context">{'search_default_active_students': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Añadir el primer alumno
            </p>
            <p>
                Los alumnos se identifican de forma permanente con su código único (ALU-XXXXX),
                que no cambia aunque pasen de grupo o de curso académico.
            </p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Vista especial: alumnos sin grupo activo (pendientes de reasignar)
    ══════════════════════════════════════════════════════════════════════ -->

    <!-- Lista simplificada: nombre, grupo anterior (archivado), asignar nuevo grupo -->
    <record id="view_student_no_group_tree" model="ir.ui.view">
        <field name="name">aula_metrics.student.no_group.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Alumnos sin grupo activo"
                  editable="top"
                  decoration-warning="active and not academic_group_id"
                  decoration-muted="not active">
                <field name="active" string="Activo"
                       help="Desmarcado = alumno archivado (p.ej. graduado). Actívalo aquí si repite curso y asígnale el nuevo grupo."/>
                <field name="name" string="Alumno" readonly="1"/>
                <field name="student_code" string="Código" readonly="1"/>
                <field name="academic_group_id"
                       string="Nuevo grupo"
                       options="{'no_create': True}"
                       domain="[('active', '=', True)]"
                       context="{'active_test': True}"
                       help="Selecciona el grupo del nuevo curso para reasignar al alumno."/>
                <field name="gender" string="Género" readonly="1" optional="hide"/>
                <field name="age" string="Edad" readonly="1" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Búsqueda para la vista de sin grupo -->
    <record id="view_student_no_group_search" model="ir.ui.view">
        <field name="name">aula_metrics.student.no_group.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Buscar alumnos sin grupo activo">
                <field name="name" string="Nombre"/>
                <field name="student_code" string="Código"/>
                <field name="academic_group_id" string="Grupo anterior"/>
            </search>
        </field>
    </record>

    <!-- Acción persistente: alumnos cuyo grupo está archivado o sin grupo -->
    <record id="action_student_no_group" model="ir.actions.act_window">
        <field name="name">Alumnos sin grupo activo</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_student_no_group_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_student_form')})]"/>
        <field name="search_view_id" ref="view_student_no_group_search"/>
        <field name="domain">[
            ('student_code', '!=', False),
            '|',
                ('academic_group_id', '=', False),
                ('academic_group_id.active', '=', False)
        ]</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay alumnos pendientes de reasignación
            </p>
            <p>
                Aquí aparecen dos tipos de alumnos:<br/>
                <strong>En naranja</strong>: alumnos activos cuyo grupo fue archivado y aún no tienen grupo nuevo asignado. Selecciona su nuevo grupo en la columna <em>Nuevo grupo</em>.<br/>
                <strong>En gris</strong>: alumnos archivados (graduados de nivel terminal como Bach2, CFGM2, etc.). Si uno de ellos repite curso, márcalo como <em>Activo</em> y asígnale el nuevo grupo.
            </p>
        </field>
    </record>
</odoo>
