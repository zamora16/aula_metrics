<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         BASE PAGE WRAPPER
         Shared outer structure for all AulaMetrics dashboard pages.

         Required values:
           page_title   (str)  – tab title (without " - AulaMetrics" suffix)
           css_styles   (str)  – pre-rendered <style> block from dashboard_styles
           head_extra   (str)  – additional <script>/<link> tags for CDN libs
           sidebar_html (str)  – pre-rendered sidebar from dashboard_layout
           topbar_html  (str)  – pre-rendered topbar from dashboard_layout
           content_html (str)  – pre-rendered main content sections
           scripts_html (str)  – pre-rendered inline <script> block(s)
         ===================================================================== -->
    <template id="dashboard_page_base" name="AulaMetrics - Base de Página">
        <html lang="es">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title><t t-out="page_title"/> - AulaMetrics</title>
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
                <link rel="stylesheet"
                      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap"/>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
                      rel="stylesheet"/>
                <t t-out="head_extra"/>
                <t t-out="css_styles"/>
            </head>
            <body>
                <div class="dashboard-layout">
                    <t t-call="aula_metrics.dashboard_sidebar"/>
                    <main class="main-content">
                        <t t-call="aula_metrics.dashboard_topbar"/>
                        <div class="content-wrapper">
                            <t t-out="content_html"/>
                        </div>
                    </main>
                </div>
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"/>
                <script>
                    /* Respect prefers-reduced-motion for all Chart.js instances */
                    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches &amp;&amp; window.Chart) {
                        Chart.defaults.animation = false;
                    }
                    document.addEventListener('DOMContentLoaded', function() {
                        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches &amp;&amp; window.Chart) {
                            Chart.defaults.animation = false;
                        }
                    });
                </script>
                <t t-out="scripts_html"/>
            </body>
        </html>
    </template>


    <!-- =====================================================================
         ACCESS DENIED PAGE
         Values: message (str, optional, defaults to generic text)
         ===================================================================== -->
    <template id="dashboard_access_denied" name="AulaMetrics - Acceso Denegado">
        <html lang="es">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Acceso Denegado - AulaMetrics</title>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
                      rel="stylesheet"/>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
            </head>
            <body class="bg-light">
                <div class="container d-flex justify-content-center align-items-center"
                     style="min-height:100vh;">
                    <div class="card shadow-sm text-center p-5" style="max-width:480px; width:100%;">
                        <i class="fa-solid fa-lock fa-4x text-danger mb-4"/>
                        <h2 class="h4 mb-3">Acceso Denegado</h2>
                        <p class="text-muted">
                            <t t-if="message">
                                <t t-out="message"/>
                            </t>
                            <t t-else="">
                                No tiene permisos para acceder a esta página.
                            </t>
                        </p>
                        <a href="/web" class="btn btn-primary mt-3">Volver al inicio</a>
                    </div>
                </div>
            </body>
        </html>
    </template>


    <!-- =====================================================================
         GENERIC ERROR PAGE
         Values: error_title (str), error_message (str)
         ===================================================================== -->
    <template id="dashboard_error_page" name="AulaMetrics - Error">
        <html lang="es">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Error - AulaMetrics</title>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
                      rel="stylesheet"/>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
            </head>
            <body class="bg-light">
                <div class="container d-flex justify-content-center align-items-center"
                     style="min-height:100vh;">
                    <div class="card shadow-sm text-center p-5" style="max-width:480px; width:100%;">
                        <i class="fa-solid fa-triangle-exclamation fa-4x text-warning mb-4"/>
                        <h2 class="h4 mb-3">
                            <t t-if="error_title">
                                <t t-out="error_title"/>
                            </t>
                            <t t-else="">Error</t>
                        </h2>
                        <p class="text-muted">
                            <t t-if="error_message">
                                <t t-out="error_message"/>
                            </t>
                        </p>
                        <a href="/web" class="btn btn-primary mt-3">Volver al inicio</a>
                    </div>
                </div>
            </body>
        </html>
    </template>

</odoo>
