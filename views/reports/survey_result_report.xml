<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_no_margin" model="report.paperformat">
        <field name="name">No Margin A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_survey_result" model="ir.actions.report">
        <field name="name">Informe de Resultados</field>
        <field name="model">aula_metrics.survey_result</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aula_metrics.report_survey_result_document</field>
        <field name="report_file">aula_metrics.report_survey_result_document</field>
        <field name="print_report_name">'%s_%s_%s' % (
            object.student_id.name.replace(' ','_'),
            (object.survey_id.survey_code or object.survey_id.title or '').replace(' ','_')[:30],
            object.completed_at.strftime('%Y%m%d'),
        )</field>
        <field name="binding_model_id" ref="model_aula_metrics_survey_result"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_no_margin"/>
    </record>

    <template id="report_survey_result_document">
        <t t-foreach="docs" t-as="doc">
            <t t-set="d" t-value="doc.get_report_data()"/>

            <div class="article">
                    <style>
                        /* ── Configuración de impresión ── */
                        @page { size: A4 portrait; margin: 0; }
                        * {
                            -webkit-print-color-adjust: exact !important;
                            print-color-adjust: exact !important;
                        }

                        /* Neutralizar estilos de Odoo sobre .article */
                        .article {
                            position: static !important;
                            margin: 0 !important;
                            padding: 0 !important;
                            min-height: 0 !important;
                            height: auto !important;
                            width: 100% !important;
                            max-width: none !important;
                            box-sizing: border-box !important;
                        }

                        /* ── Tipografía base ── */
                        .am-report {
                            font-family: Arial, sans-serif;
                            font-size: 11pt;
                            color: #1e293b;
                            width: 100%;
                            display: -webkit-box;
                            display: -webkit-flex;
                            display: flex;
                            -webkit-box-orient: vertical;
                            -webkit-flex-direction: column;
                            flex-direction: column;
                            height: 297mm;
                            box-sizing: border-box;
                        }
                        .am-report p { margin: 0 0 6pt 0; }

                        /* ── CABECERA ── */
                        .am-header {
                            background: #1A5C52 !important;
                            padding: 20pt 24pt 16pt;
                            border-bottom: 3pt solid #D4621A !important;
                            -webkit-print-color-adjust: exact !important;
                        }
                        .am-header .tag {
                            font-size: 8pt;
                            letter-spacing: 0.1em;
                            text-transform: uppercase;
                            color: rgba(168, 216, 208, 1) !important;
                            margin-bottom: 6pt;
                        }
                        .am-header h1 {
                            font-size: 18pt;
                            font-weight: bold;
                            margin: 0 0 14pt;
                            line-height: 1.2;
                            color: #ffffff !important;
                        }
                        .am-header .meta-table {
                            width: 100%;
                            border-collapse: collapse;
                            border: none !important;
                        }
                        .am-header .meta-table td {
                            padding: 0 24pt 0 0;
                            vertical-align: top;
                            color: #ffffff !important;
                            font-size: 10.5pt;
                            border: none !important;
                        }
                        .am-header .meta-label {
                            font-size: 8pt;
                            font-weight: bold;
                            text-transform: uppercase;
                            letter-spacing: 0.08em;
                            color: rgba(168, 216, 208, 1) !important;
                            margin-bottom: 3pt;
                        }

                        /* ── Suprimir bordes de tablas en cabecera ── */
                        .am-header table,
                        .am-header tr,
                        .am-header td {
                            border: none !important;
                            outline: none !important;
                        }

                        /* ── CUERPO ── */
                        .am-body {
                            padding: 20pt 24pt 24pt;
                            -webkit-box-flex: 1;
                            -webkit-flex: 1;
                            flex: 1;
                        }

                        /* ── AVISO LEGAL ── */
                        .am-disclaimer {
                            border-left: 3pt solid #1A5C52 !important;
                            background: #f8fafc !important;
                            padding: 12pt 16pt;
                            margin-bottom: 18pt;
                            font-size: 9.5pt;
                            color: #475569;
                            line-height: 1.6;
                            -webkit-print-color-adjust: exact !important;
                        }
                        .am-disclaimer .disc-title {
                            font-weight: bold;
                            font-size: 9.5pt;
                            color: #334155;
                            text-transform: uppercase;
                            letter-spacing: 0.06em;
                            margin-bottom: 6pt;
                        }
                        .am-disclaimer ul {
                            margin: 6pt 0 0 14pt;
                            padding: 0;
                        }
                        .am-disclaimer ul li { margin-bottom: 5pt; }

                        /* ── TÍTULOS DE SECCIÓN ── */
                        .am-section-title {
                            font-size: 9pt;
                            font-weight: bold;
                            text-transform: uppercase;
                            letter-spacing: 0.1em;
                            color: #1A5C52;
                            border-bottom: 1.5pt solid #B8DED9 !important;
                            padding-bottom: 4pt;
                            margin: 18pt 0 12pt;
                        }

                        /* ── RESULTADO GLOBAL ── */
                        .am-global {
                            padding: 16pt 18pt;
                            border-radius: 4pt;
                            margin-bottom: 4pt;
                            -webkit-print-color-adjust: exact !important;
                        }
                        .am-global .score-big {
                            font-size: 36pt;
                            font-weight: bold;
                            line-height: 1;
                            vertical-align: middle;
                        }
                        .am-global .sev-badge {
                            display: inline-block;
                            padding: 4pt 12pt;
                            border-radius: 3pt;
                            font-size: 10.5pt;
                            font-weight: bold;
                            color: #ffffff !important;
                            margin-left: 10pt;
                            vertical-align: middle;
                            -webkit-print-color-adjust: exact !important;
                        }
                        .am-global .interp {
                            font-size: 10pt;
                            color: #475569;
                            margin-top: 8pt;
                            line-height: 1.5;
                        }

                        /* ── TABLA DE ESCALAS ── */
                        .am-scales {
                            width: 100%;
                            border-collapse: collapse;
                        }
                        .am-scales td {
                            vertical-align: middle;
                            padding: 8pt 6pt;
                            border: none !important;
                        }
                        .am-scales tr {
                            border: none !important;
                        }
                        /* Separador sutil entre filas de escala */
                        .am-scales tr.scale-row {
                            border-top: 1pt solid #f1f5f9 !important;
                        }
                        .am-scales tr.scale-row:first-child {
                            border-top: none !important;
                        }
                        .am-scales .td-lbl {
                            width: 30%;
                            font-weight: bold;
                            font-size: 10.5pt;
                            color: #1e293b;
                            padding-right: 12pt;
                        }
                        .am-scales .td-bar {
                            width: 40%;
                            padding-right: 12pt;
                        }
                        .am-scales .td-score {
                            width: 10%;
                            text-align: right;
                            font-weight: bold;
                            font-size: 10.5pt;
                            padding-right: 8pt;
                            white-space: nowrap;
                        }
                        .am-scales .td-score .max {
                            font-weight: 400;
                            color: #94a3b8;
                        }
                        .am-scales .td-sev {
                            width: 20%;
                            text-align: center;
                        }
                        .am-scales .sev-pill {
                            display: inline-block;
                            padding: 3pt 10pt;
                            border-radius: 3pt;
                            font-size: 9pt;
                            font-weight: bold;
                            color: #ffffff !important;
                            white-space: nowrap;
                            -webkit-print-color-adjust: exact !important;
                        }
                        .am-scales .bar-track {
                            height: 8pt;
                            background: #e9eef4 !important;
                            border-radius: 4pt;
                            overflow: hidden;
                            -webkit-print-color-adjust: exact !important;
                        }
                        .am-scales .bar-fill {
                            height: 8pt;
                            border-radius: 4pt;
                            -webkit-print-color-adjust: exact !important;
                        }
                        .am-scales .td-desc {
                            font-size: 9.5pt;
                            color: #64748b;
                            line-height: 1.5;
                            padding: 0 6pt 10pt;
                            vertical-align: top;
                            border: none !important;
                        }
                        /* Separador visual antes del Total */
                        .am-scales tr.total-sep td {
                            border-top: 1.5pt solid #cbd5e1 !important;
                            padding-top: 10pt;
                        }

                        /* ── PIE ── */
                        .am-footer {
                            padding: 8pt 24pt;
                            border-top: 2pt solid #D4621A !important;
                            font-size: 8pt;
                            color: #5A4E48;
                            text-align: center;
                            -webkit-flex-shrink: 0;
                            flex-shrink: 0;
                            -webkit-print-color-adjust: exact !important;
                        }
                    </style>

                    <main>
                        <div class="am-report">

                        <!-- CABECERA -->
                        <t t-set="am_company" t-value="env.company"/>
                        <div class="am-header">
                            <table border="0" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:separate;border-spacing:0;border:none;">
                                <tr>
                                    <td style="vertical-align:top;border:none;padding:0;width:100%;">
                                        <div class="tag">Informe de Resultados · <t t-out="am_company.name"/></div>
                                        <h1><t t-out="d['survey_title']"/></h1>
                                        <table border="0" cellspacing="0" cellpadding="0" class="meta-table">
                                            <tr>
                                                <td>
                                                    <div class="meta-label">Alumno/a</div>
                                                    <t t-out="d['student_name']"/>
                                                    <t t-if="d['student_age']">
                                                        &#160;(<t t-out="d['student_age']"/> a&#241;os)
                                                    </t>
                                                </td>
                                                <td>
                                                    <div class="meta-label">Fecha de respuesta</div>
                                                    <t t-out="d['completed_at'].strftime('%d/%m/%Y')"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <t t-if="am_company.logo">
                                        <td style="vertical-align:middle;text-align:right;border:none;padding:0 0 0 16pt;white-space:nowrap;">
                                            <img t-att-src="'/web/image/res.company/' + str(am_company.id) + '/logo'"
                                                 style="max-height:40pt;max-width:110pt;object-fit:contain;display:block;margin-left:auto;"/>
                                        </td>
                                    </t>
                                </tr>
                            </table>
                        </div>

                        <!-- CUERPO -->
                        <div class="am-body">

                            <!-- AVISO LEGAL -->
                            <div class="am-disclaimer">
                                <div class="disc-title">Nota importante sobre este informe</div>
                                <p>
                                    Este informe no es el resultado de una evaluaci&#243;n psicol&#243;gica
                                    ni de una valoraci&#243;n cl&#237;nica completa, sino que se refiere
                                    &#250;nicamente a los resultados obtenidos con la administraci&#243;n de
                                    algunos instrumentos de medida con fines de orientaci&#243;n educativa.
                                    Esta particularidad conlleva la consideraci&#243;n de diferentes aspectos
                                    para su correcta lectura e interpretaci&#243;n:
                                </p>
                                <ul>
                                    <li>Los resultados obtenidos son de car&#225;cter
                                        <b>exclusivamente informativo</b> y no permiten establecer
                                        ning&#250;n diagn&#243;stico.</li>
                                    <li>Estos datos se refieren &#250;nicamente al momento de la
                                        evaluaci&#243;n y no permiten establecer predicciones sobre el
                                        funcionamiento psicol&#243;gico de la persona en el futuro.</li>
                                    <li>Las conclusiones se basan &#250;nicamente en las respuestas
                                        obtenidas durante la sesi&#243;n, por lo que han de tomarse con la
                                        debida cautela y no pueden ser generalizadas a otros contextos.</li>
                                </ul>
                            </div>

                            <!-- RESULTADO GLOBAL -->
                            <div class="am-section-title">Resultado global</div>
                            <div class="am-global"
                                 t-att-style="'background:{bg} !important;border:none;'.format(bg=d['global_sev_bg'])">
                                <span class="score-big"
                                      t-att-style="'color:{c};'.format(c=d['global_sev_color'])">
                                    <t t-out="'%.0f' % d['raw_score']"/>
                                    <t t-if="d['raw_score_max']">
                                        <span style="font-weight:400;color:#64748b;font-size:0.8em;">/<t t-out="'%.0f' % d['raw_score_max']"/></span>
                                    </t>
                                </span>
                                <span class="sev-badge"
                                      t-att-style="'background:{c} !important;'.format(c=d['global_sev_color'])">
                                    <t t-out="d['global_label']"/>
                                </span>
                                <t t-if="d['global_description']">
                                    <div class="interp"><t t-out="d['global_description']"/></div>
                                </t>
                            </div>

                            <!-- DESGLOSE POR ESCALAS -->
                            <t t-if="d['scales']">
                                <div class="am-section-title">Desglose por escalas</div>
                                <table class="am-scales">
                                    <t t-foreach="d['scales']" t-as="sc">
                                        <tr t-att-class="'total-sep' if sc['is_total'] else 'scale-row'">
                                            <td class="td-lbl"><t t-out="sc['label']"/></td>
                                            <td class="td-bar">
                                                <div class="bar-track">
                                                    <div class="bar-fill"
                                                         t-att-style="'width:{}%;background:{} !important;'.format(sc['pct_str'], sc['sev_color'])"/>
                                                </div>
                                            </td>
                                            <td class="td-score"
                                                t-att-style="'color:{c};'.format(c=sc['sev_color'])">
                                                <t t-out="sc['score_str']"/>
                                                <span class="max">/<t t-out="sc['max_str']"/></span>
                                            </td>
                                            <td class="td-sev">
                                                <span class="sev-pill"
                                                      t-att-style="'background:{c} !important;'.format(c=sc['sev_color'])">
                                                    <t t-out="sc['sev_label']"/>
                                                </span>
                                            </td>
                                        </tr>
                                        <t t-if="sc['description']">
                                            <tr>
                                                <td colspan="4" class="td-desc">
                                                    <t t-out="sc['description']"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </table>
                            </t>

                        </div><!-- /am-body -->

                        <div class="am-footer">
                            AulaMetrics &#183;
                            <t t-out="d['student_name']"/> &#183;
                            <t t-out="d['survey_title']"/> &#183;
                            <t t-out="d['completed_at'].strftime('%d/%m/%Y')"/> &#183;
                            Exclusivamente informativo, no constituye diagn&#243;stico.
                        </div>

                    </div><!-- /am-report -->
                    </main>
                </div><!-- /article -->

            </t>
    </template>

</odoo>