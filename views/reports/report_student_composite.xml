<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Modelo de datos para el informe compuesto ── -->
    <record id="action_report_student_composite" model="ir.actions.report">
        <field name="name">Informe Compuesto de Alumno</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aula_metrics.report_student_composite</field>
        <field name="report_file">aula_metrics.report_student_composite</field>
        <field name="paperformat_id" ref="aula_metrics.paperformat_no_margin"/>
    </record>

    <!-- ── Plantilla QWeb ── -->
    <template id="report_student_composite">
        <div class="article">
            <style>
                /* ── Configuración de impresión ── */
                @page { size: A4 portrait; margin: 0; }
                * {
                    -webkit-print-color-adjust: exact !important;
                    print-color-adjust: exact !important;
                }
                .article {
                    position: static !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    min-height: 0 !important;
                    height: auto !important;
                    width: 100% !important;
                    max-width: none !important;
                    box-sizing: border-box !important;
                }

                /* ── Tipografía base ── */
                .am-report {
                    font-family: Arial, sans-serif;
                    font-size: 11pt;
                    color: #1e293b;
                    width: 100%;
                    display: -webkit-box;
                    display: -webkit-flex;
                    display: flex;
                    -webkit-box-orient: vertical;
                    -webkit-flex-direction: column;
                    flex-direction: column;
                    height: 297mm;
                    box-sizing: border-box;
                }
                .am-report p { margin: 0 0 6pt 0; }

                /* ── Anti-corte en saltos de página ── */
                .am-header    { page-break-inside: avoid; break-inside: avoid; }
                .am-global    { page-break-inside: avoid; break-inside: avoid; }
                .am-disclaimer { page-break-inside: avoid; break-inside: avoid; }
                .am-footer    { page-break-inside: avoid; break-inside: avoid;
                                page-break-before: avoid; break-before: avoid; }
                .am-scales tr { page-break-inside: avoid; break-inside: avoid; }
                .am-section-title { page-break-after: avoid; break-after: avoid; }

                /* ── CABECERA ── */
                .am-header {
                    background: #1A5C52 !important;
                    padding: 20pt 24pt 16pt;
                    border-bottom: 3pt solid #D4621A !important;
                    -webkit-print-color-adjust: exact !important;
                }
                .am-header .tag {
                    font-size: 8pt; letter-spacing: 0.1em;
                    text-transform: uppercase; color: rgba(168, 216, 208, 1) !important; margin-bottom: 6pt;
                }
                .am-header h1 {
                    font-size: 18pt; font-weight: bold;
                    margin: 0 0 14pt; line-height: 1.2; color: #ffffff !important;
                }
                .am-header .meta-table {
                    width: 100%; border-collapse: separate; border-spacing: 0; border: none !important;
                }
                .am-header .meta-table td {
                    padding: 0 24pt 0 0; vertical-align: top;
                    color: #ffffff !important; font-size: 10.5pt; border: none !important;
                }
                .am-header .meta-label {
                    font-size: 8pt; font-weight: bold; text-transform: uppercase;
                    letter-spacing: 0.08em; color: rgba(168, 216, 208, 1) !important; margin-bottom: 3pt;
                }

                /* ── Suprimir bordes de tablas en cabecera ── */
                .am-header table,
                .am-header tr,
                .am-header td {
                    border: none !important;
                    outline: none !important;
                }

                /* ── CUERPO ── */
                .am-body {
                    padding: 20pt 24pt 24pt;
                    -webkit-box-flex: 1;
                    -webkit-flex: 1;
                    flex: 1;
                }

                /* ── AVISO LEGAL ── */
                .am-disclaimer {
                    border-left: 3pt solid #1A5C52 !important;
                    background: #f8fafc !important; padding: 12pt 16pt; margin-bottom: 18pt;
                    font-size: 9.5pt; color: #475569; line-height: 1.6;
                    -webkit-print-color-adjust: exact !important;
                }
                .am-disclaimer .disc-title {
                    font-weight: bold; font-size: 9.5pt; color: #334155;
                    text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6pt;
                }
                .am-disclaimer ul { margin: 6pt 0 0 14pt; padding: 0; }
                .am-disclaimer ul li { margin-bottom: 5pt; }

                /* ── PORTADA ── */
                .am-cover-body {
                    padding: 50pt 24pt 40pt;
                    -webkit-box-flex: 1;
                    -webkit-flex: 1;
                    flex: 1;
                }
                .am-cover-title {
                    font-size: 26pt; font-weight: bold;
                    color: #1e293b; margin-bottom: 8pt;
                }
                .am-cover-subtitle { font-size: 14pt; color: #64748b; margin-bottom: 30pt; }
                .am-cover-meta td {
                    padding: 6pt 24pt 6pt 0; font-size: 11pt;
                    vertical-align: top; border: none !important;
                }
                .am-cover-meta .lbl {
                    font-size: 8.5pt; font-weight: bold; text-transform: uppercase;
                    letter-spacing: 0.07em; color: #94a3b8; margin-bottom: 3pt;
                }
                .am-cover-meta .val { font-weight: 600; color: #1e293b; }
                .am-cover-list { margin-top: 30pt; }
                .am-cover-list h3 {
                    font-size: 10pt; font-weight: bold; text-transform: uppercase;
                    letter-spacing: 0.08em; color: #1A5C52;
                    border-bottom: 1.5pt solid #B8DED9 !important; padding-bottom: 6pt; margin-bottom: 12pt;
                }
                .am-cover-list li { font-size: 11pt; color: #1e293b; margin-bottom: 6pt; }

                /* ── SECCIÓN DE ESCALAS ── */
                .am-section-title {
                    font-size: 9pt; font-weight: bold; text-transform: uppercase;
                    letter-spacing: 0.1em; color: #1A5C52;
                    border-bottom: 1.5pt solid #B8DED9 !important;
                    padding-bottom: 4pt; margin: 18pt 0 12pt;
                }

                /* ── RESULTADO GLOBAL ── */
                .am-global {
                    padding: 16pt 18pt; border-radius: 4pt; margin-bottom: 4pt;
                    -webkit-print-color-adjust: exact !important;
                }
                .am-global .score-big { font-size: 36pt; font-weight: bold; line-height: 1; }
                .am-global .sev-badge {
                    display: inline-block; padding: 4pt 12pt; border-radius: 3pt;
                    font-size: 10.5pt; font-weight: bold; color: #ffffff !important;
                    margin-left: 10pt; -webkit-print-color-adjust: exact !important;
                }
                .am-global .interp { font-size: 10pt; color: #475569; margin-top: 8pt; line-height: 1.5; }

                /* ── TABLA DE ESCALAS ── */
                .am-scales { width: 100%; border-collapse: collapse; }
                .am-scales td { vertical-align: middle; padding: 8pt 6pt; border: none !important; }
                .am-scales tr { border: none !important; }
                .am-scales tr.scale-row { border-top: 1pt solid #f1f5f9 !important; }
                .am-scales tr.scale-row:first-child { border-top: none !important; }
                .am-scales .td-lbl { width: 30%; font-weight: bold; font-size: 10.5pt; color: #1e293b; padding-right: 12pt; }
                .am-scales .td-bar { width: 40%; padding-right: 12pt; }
                .am-scales .td-score { width: 10%; text-align: right; font-weight: bold; font-size: 10.5pt; padding-right: 8pt; white-space: nowrap; }
                .am-scales .td-score .max { font-weight: 400; color: #94a3b8; }
                .am-scales .td-sev { width: 20%; text-align: center; }
                .am-scales .sev-pill {
                    display: inline-block; padding: 3pt 10pt; border-radius: 3pt;
                    font-size: 9pt; font-weight: bold; color: #ffffff !important; white-space: nowrap;
                    -webkit-print-color-adjust: exact !important;
                }
                .am-scales .bar-track { height: 8pt; background: #e9eef4 !important; border-radius: 4pt; overflow: hidden; -webkit-print-color-adjust: exact !important; }
                .am-scales .bar-fill  { height: 8pt; border-radius: 4pt; -webkit-print-color-adjust: exact !important; }
                .am-scales .td-desc   { font-size: 9.5pt; color: #64748b; line-height: 1.5; padding: 0 6pt 10pt; vertical-align: top; border: none !important; }
                .am-scales tr.total-sep td { border-top: 1.5pt solid #cbd5e1 !important; padding-top: 10pt; }

                /* ── PIE ── */
                .am-footer {
                    padding: 8pt 24pt;
                    border-top: 2pt solid #D4621A !important;
                    font-size: 8pt; color: #5A4E48; text-align: center;
                    -webkit-flex-shrink: 0;
                    flex-shrink: 0;
                    -webkit-print-color-adjust: exact !important;
                }
            </style>

            <!-- ══════════ PORTADA ══════════ -->
            <t t-set="am_company" t-value="env.company"/>
            <main class="am-report">
                <div class="am-header">
                    <table border="0" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:separate;border-spacing:0;border:none;">
                        <tr>
                            <td style="vertical-align:top;border:none;padding:0;width:100%;">
                                <div class="tag">Evaluaci&#243;n Psicosocial · <t t-out="am_company.name"/></div>
                                <h1>Informe compuesto de evaluaci&#243;n</h1>
                                <table border="0" cellspacing="0" cellpadding="0" class="meta-table">
                                    <tr>
                                        <td>
                                            <div class="meta-label">Alumno/a</div>
                                            <t t-out="student_name or (docs and docs[0].name) or ''"/>
                                        </td>
                                        <td>
                                            <div class="meta-label">Grupo</div>
                                            <t t-out="student_group or ''"/>
                                        </td>
                                        <td>
                                            <div class="meta-label">Generado el</div>
                                            <t t-out="generated_date or ''"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <t t-if="am_company.logo">
                                <td style="vertical-align:middle;text-align:right;border:none;padding:0 0 0 16pt;white-space:nowrap;">
                                    <img t-att-src="'/web/image/res.company/' + str(am_company.id) + '/logo'"
                                         style="max-height:40pt;max-width:110pt;object-fit:contain;display:block;margin-left:auto;"/>
                                </td>
                            </t>
                        </tr>
                    </table>
                </div>

                <div class="am-cover-body">
                    <div style="display:flex;gap:40pt;flex-wrap:wrap;">
                        <div class="am-cover-list" style="flex:1;min-width:120pt;">
                            <h3>Evaluaciones incluidas</h3>
                            <ul>
                                <t t-foreach="evaluation_names or []" t-as="en">
                                    <li><t t-out="en"/></li>
                                </t>
                            </ul>
                        </div>
                        <div class="am-cover-list" style="flex:1;min-width:120pt;">
                            <h3>Cuestionarios incluidos</h3>
                            <ul>
                                <t t-foreach="survey_titles or []" t-as="st">
                                    <li><t t-out="st"/></li>
                                </t>
                            </ul>
                        </div>
                    </div>

                    <div class="am-disclaimer" style="margin-top:24pt;">
                        <div class="disc-title">Nota importante sobre este informe</div>
                        <p>
                            Este informe no es el resultado de una evaluaci&#243;n psicol&#243;gica
                            ni de una valoraci&#243;n cl&#237;nica completa, sino que se refiere
                            &#250;nicamente a los resultados obtenidos con instrumentos de
                            medida con fines de orientaci&#243;n educativa.
                        </p>
                        <ul>
                            <li>Los resultados son de car&#225;cter <b>exclusivamente informativo</b>
                                y no permiten establecer ning&#250;n diagn&#243;stico.</li>
                            <li>Los datos se refieren al momento de la evaluaci&#243;n y no permiten
                                predicciones sobre el funcionamiento futuro.</li>
                        </ul>
                    </div>
                </div>

                <div class="am-footer">
                    Informe compuesto generado por AulaMetrics &#183;
                    <t t-out="student_name or ''"/> &#183;
                    Fecha de generaci&#243;n: <t t-out="generated_date or ''"/>
                </div>
            </main>

            <!-- ══════════ PÁGINAS DE RESULTADOS ══════════ -->
            <t t-foreach="pages or []" t-as="d">
                    <main class="am-report" style="page-break-before: always; break-before: page;">
                        <div class="am-header">
                            <table border="0" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:separate;border-spacing:0;border:none;">
                                <tr>
                                    <td style="vertical-align:top;border:none;padding:0;width:100%;">
                                        <div class="tag"><t t-out="d.get('evaluation_name', '')"/> · <t t-out="am_company.name"/></div>
                                        <h1><t t-out="d.get('survey_title', '')"/></h1>
                                        <table border="0" cellspacing="0" cellpadding="0" class="meta-table">
                                            <tr>
                                                <td>
                                                    <div class="meta-label">Alumno/a</div>
                                                    <t t-out="d.get('student_name', '')"/>
                                                    <t t-if="d.get('student_age')">
                                                        &#160;(<t t-out="d['student_age']"/> a&#241;os)
                                                    </t>
                                                </td>
                                                <td>
                                                    <div class="meta-label">Fecha de respuesta</div>
                                                    <t t-out="d['completed_at'].strftime('%d/%m/%Y') if d.get('completed_at') else ''"/>
                                                </td>
                                                <td>
                                                    <div class="meta-label">Evaluaci&#243;n</div>
                                                    <t t-out="d.get('evaluation_name', '')"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <t t-if="am_company.logo">
                                        <td style="vertical-align:middle;text-align:right;border:none;padding:0 0 0 16pt;white-space:nowrap;">
                                            <img t-att-src="'/web/image/res.company/' + str(am_company.id) + '/logo'"
                                                 style="max-height:40pt;max-width:110pt;object-fit:contain;display:block;margin-left:auto;"/>
                                        </td>
                                    </t>
                                </tr>
                            </table>
                        </div>

                        <div class="am-body">
                            <!-- Resultado global -->
                            <div class="am-section-title">Resultado global</div>
                            <div class="am-global"
                                 t-att-style="'background:{bg} !important;border:none;'.format(bg=d.get('global_sev_bg','#f8fafc'))">
                                <span class="score-big"
                                      t-att-style="'color:{c};'.format(c=d.get('global_sev_color','#1e293b'))">
                                    <t t-out="'%.0f' % (d.get('raw_score') or 0)"/>
                                    <t t-if="d.get('raw_score_max')">
                                        <span style="font-weight:400;color:#64748b;font-size:0.8em;">/<t t-out="'%.0f' % d['raw_score_max']"/></span>
                                    </t>
                                </span>
                                <span class="sev-badge"
                                      t-att-style="'background:{c} !important;'.format(c=d.get('global_sev_color','#94a3b8'))">
                                    <t t-out="d.get('global_label', '')"/>
                                </span>
                                <t t-if="d.get('global_description')">
                                    <div class="interp"><t t-out="d['global_description']"/></div>
                                </t>
                            </div>

                            <!-- Desglose por escalas -->
                            <t t-if="d.get('scales')">
                                <div class="am-section-title">Desglose por escalas</div>
                                <table class="am-scales">
                                    <t t-foreach="d['scales']" t-as="sc">
                                        <tr t-att-class="'total-sep' if sc.get('is_total') else 'scale-row'">
                                            <td class="td-lbl"><t t-out="sc.get('label','')"/></td>
                                            <td class="td-bar">
                                                <div class="bar-track">
                                                    <div class="bar-fill"
                                                         t-att-style="'width:{p}%;background:{c} !important;'.format(p=sc.get('pct_str','0'), c=sc.get('sev_color','#ccc'))"/>
                                                </div>
                                            </td>
                                            <td class="td-score"
                                                t-att-style="'color:{c};'.format(c=sc.get('sev_color','#1e293b'))">
                                                <t t-out="sc.get('score_str','0')"/>
                                                <span class="max">/<t t-out="sc.get('max_str','')"/></span>
                                            </td>
                                            <td class="td-sev">
                                                <span class="sev-pill"
                                                      t-att-style="'background:{c} !important;'.format(c=sc.get('sev_color','#ccc'))">
                                                    <t t-out="sc.get('sev_label','')"/>
                                                </span>
                                            </td>
                                        </tr>
                                        <t t-if="sc.get('description')">
                                            <tr><td colspan="4" class="td-desc"><t t-out="sc['description']"/></td></tr>
                                        </t>
                                    </t>
                                </table>
                            </t>
                        </div>

                        <div class="am-footer">
                            AulaMetrics &#183; <t t-out="d.get('student_name','')"/> &#183;
                            <t t-out="d.get('survey_title','')"/> &#183;
                            <t t-out="d['completed_at'].strftime('%d/%m/%Y') if d.get('completed_at') else ''"/>
                            &#183; Exclusivamente informativo, no constituye diagn&#243;stico.
                        </div>
                    </main>

            </t><!-- /t-foreach pages -->
        </div><!-- /article -->
    </template>

</odoo>
