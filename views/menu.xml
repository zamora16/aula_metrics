<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú Principal -->
    <menuitem id="menu_aulametrics_root" 
              name="AulaMetrics" 
              web_icon="aula_metrics,static/description/icon.png"
              sequence="10"/>

    <!-- Inicio / Dashboard -->
    <menuitem id="menu_aulametrics_home" 
              name="Inicio" 
              parent="menu_aulametrics_root"
              action="action_dashboard_home"
              sequence="1"/>

    <!-- Cuestionarios -->
    <menuitem id="menu_aulametrics_surveys" 
              name="Cuestionarios" 
              parent="menu_aulametrics_root"
              sequence="5"/>
              
    <menuitem id="menu_aulametrics_surveys_official" 
              name="Cuestionarios Oficiales" 
              parent="menu_aulametrics_surveys"
              action="action_survey_official"
              sequence="10"/>
              
    <menuitem id="menu_aulametrics_surveys_adhoc"
              name="Cuestionarios del Centro"
              parent="menu_aulametrics_surveys"
              action="action_survey_adhoc"
              groups="aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_admin"
              active="0"
              sequence="20"/>

    <!-- Evaluaciones -->
    <menuitem id="menu_aulametrics_evaluations" 
              name="Evaluaciones" 
              parent="menu_aulametrics_root" 
              action="action_evaluation"
              sequence="10"/>

    <!-- Resultados (Dashboard General) -->
    <menuitem id="menu_aulametrics_results" 
              name="Resultados" 
              parent="menu_aulametrics_root"
              action="action_dashboard_hub"
              sequence="20"/>
    
    <!-- Alertas -->
    <menuitem id="menu_aulametrics_alerts" 
              name="Sistema de Alertas" 
              parent="menu_aulametrics_root" 
              sequence="30"/>
              
    <menuitem id="menu_aulametrics_alerts_dashboard" 
              name="Dashboard de Alertas" 
              parent="menu_aulametrics_alerts"
              action="action_alerts_dashboard"
              sequence="10"/>

    <menuitem id="menu_aulametrics_notify_counselor"
              name="Notificar al Orientador"
              parent="menu_aulametrics_alerts"
              action="aula_metrics.action_manual_alert_wizard"
              sequence="15"
              groups="aula_metrics.group_aulametrics_tutor"/>
              
    <menuitem id="menu_aulametrics_thresholds" 
              name="Configurar Umbrales" 
              parent="menu_aulametrics_alerts"
              action="action_threshold"
              groups="group_aulametrics_admin,group_aulametrics_counselor"
              sequence="20"/>
              
    <menuitem id="menu_alert_keywords" 
              name="Palabras Clave de Alerta" 
              parent="menu_aulametrics_alerts"
              action="action_alert_keyword"
              groups="group_aulametrics_admin,group_aulametrics_counselor"
              sequence="30"/>

    <!-- Configuración del Centro -->
    <menuitem id="menu_aulametrics_config"
              name="Configuración del Centro"
              parent="menu_aulametrics_root"
              groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_management"
              sequence="80"/>

    <!-- Cursos Académicos -->
    <menuitem id="menu_academic_years"
              name="Cursos Académicos"
              parent="menu_aulametrics_config"
              action="action_academic_year_list"
              groups="group_aulametrics_admin,group_aulametrics_counselor,group_aulametrics_management"
              sequence="10"/>

    <!-- Grupos Educativos -->
    <menuitem id="menu_academic_groups"
              name="Grupos Educativos"
              parent="menu_aulametrics_config"
              action="action_academic_group"
              groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_management"
              sequence="20"/>

    <!-- Alumnos -->
    <menuitem id="menu_students_config"
              name="Alumnos"
              parent="menu_aulametrics_config"
              action="aula_metrics.action_student_list"
              groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor"
              sequence="30"/>

    <!-- Herramientas de primer año (uso único) -->
    <menuitem id="menu_first_year_setup"
              name="Configuración Inicial"
              parent="menu_aulametrics_config"
              action="aula_metrics.action_first_year_wizard_smart"
              groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor"
              sequence="50"/>

    <!-- Importación masiva de alumnos (solo primer año) -->
    <menuitem id="menu_student_import"
              name="Importar Alumnos"
              parent="menu_aulametrics_config"
              action="aula_metrics.action_student_import_wizard_smart"
              groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor"
              sequence="60"/>

    <!-- Paso de Curso: oculto hasta activación manual (acción disponible pero sin entrada de menú) -->

    <!-- Comunicaciones Internas -->
    <menuitem id="menu_aulametrics_comms_root"
              name="Comunicaciones"
              parent="menu_aulametrics_root"
              sequence="40"
              groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_tutor,aula_metrics.group_aulametrics_management"/>

    <menuitem id="menu_aulametrics_comms"
              name="Hilos de Comunicación"
              parent="menu_aulametrics_comms_root"
              action="aula_metrics.action_message_thread"
              sequence="10"
              groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_tutor,aula_metrics.group_aulametrics_management"/>

    <!-- Orientación: Casos -->
    <menuitem id="menu_aulametrics_cases_root"
              name="Orientación"
              parent="menu_aulametrics_root"
              sequence="35"
              groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_tutor"/>

    <menuitem id="menu_aulametrics_cases"
              name="Casos de Orientación"
              parent="menu_aulametrics_cases_root"
              action="action_case"
              sequence="10"
              groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor,aula_metrics.group_aulametrics_tutor"/>

    <menuitem id="menu_aulametrics_case_stages"
              name="Configurar Fases"
              parent="menu_aulametrics_cases_root"
              action="action_case_stage"
              sequence="20"
              groups="aula_metrics.group_aulametrics_admin,aula_metrics.group_aulametrics_counselor"/>
</odoo>