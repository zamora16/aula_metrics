<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú Principal -->
    <menuitem id="menu_aulametrics_root" 
              name="AulaMetrics" 
              web_icon="aula_metrics,static/description/icon.png"
              sequence="10"/>

    <!-- Inicio / Dashboard -->
    <menuitem id="menu_aulametrics_home" 
              name="Inicio" 
              parent="menu_aulametrics_root"
              action="action_dashboard_home"
              sequence="1"/>

    <!-- Cuestionarios -->
    <menuitem id="menu_aulametrics_surveys" 
              name="Cuestionarios" 
              parent="menu_aulametrics_root"
              sequence="5"/>
              
    <menuitem id="menu_aulametrics_surveys_official" 
              name="Cuestionarios Oficiales" 
              parent="menu_aulametrics_surveys"
              action="action_survey_official"
              sequence="10"/>
              
    <menuitem id="menu_aulametrics_surveys_adhoc" 
              name="Cuestionarios del Centro" 
              parent="menu_aulametrics_surveys"
              action="action_survey_adhoc"
              groups="group_aulametrics_counselor,group_aulametrics_admin"
              sequence="20"/>

    <!-- Evaluaciones -->
    <menuitem id="menu_aulametrics_evaluations" 
              name="Evaluaciones" 
              parent="menu_aulametrics_root" 
              action="action_evaluation"
              sequence="10"/>

    <!-- Resultados (Dashboard General) -->
    <menuitem id="menu_aulametrics_results" 
              name="Resultados" 
              parent="menu_aulametrics_root"
              action="action_dashboard_hub"
              sequence="20"/>
    
    <!-- Alertas -->
    <menuitem id="menu_aulametrics_alerts" 
              name="Sistema de Alertas" 
              parent="menu_aulametrics_root" 
              sequence="30"/>
              
    <menuitem id="menu_aulametrics_alerts_dashboard" 
              name="Dashboard de Alertas" 
              parent="menu_aulametrics_alerts"
              action="action_alerts_dashboard"
