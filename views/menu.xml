              action="aula_metrics.action_manual_alert_wizard"
              sequence="15"
              groups="aula_metrics.group_aulametrics_tutor"/>
              
    <menuitem id="menu_aulametrics_thresholds" 
              name="Configurar Umbrales" 
              parent="menu_aulametrics_alerts"
              action="action_threshold"
              groups="group_aulametrics_admin,group_aulametrics_counselor"
              sequence="20"/>
              
    <menuitem id="menu_alert_keywords" 
              name="Palabras Clave de Alerta" 
