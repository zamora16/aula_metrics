<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- LISTA                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="view_message_thread_list" model="ir.ui.view">
        <field name="name">aula_metrics.message_thread.list</field>
        <field name="model">aula_metrics.message_thread</field>
        <field name="arch" type="xml">
            <tree string="Comunicaciones"
                  decoration-muted="state == 'closed'"
                  decoration-success="state == 'open'">
                <field name="name" string="Asunto"/>
                <field name="creator_id" string="Iniciado por"/>
                <field name="participant_count" string="Nº participantes"/>
                <field name="write_date" string="Última actividad"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- KANBAN                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="view_message_thread_kanban" model="ir.ui.view">
        <field name="name">aula_metrics.message_thread.kanban</field>
        <field name="model">aula_metrics.message_thread</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="creator_id"/>
                <field name="participant_ids"/>
                <field name="participant_count"/>
                <field name="state"/>
                <field name="write_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb8">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="text-muted small">
                                        <i class="fa fa-user me-1" title="Creado por"/>
                                        <field name="creator_id"/>
                                    </div>
                                    <div class="text-muted small mt4">
                                        <i class="fa fa-users me-1" title="Participantes"/>
                                        <field name="participant_count"/> participantes
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left"/>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="badge"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- FORMULARIO                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="view_message_thread_form" model="ir.ui.view">
        <field name="name">aula_metrics.message_thread.form</field>
        <field name="model">aula_metrics.message_thread</field>
        <field name="arch" type="xml">
            <form string="Comunicación">
                <header>
                    <button name="action_close"
                            string="Cerrar hilo"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'closed'"
                            confirm="¿Cerrar este hilo de comunicación? Los participantes no podrán añadir nuevos mensajes."/>
                    <button name="action_reopen"
                            string="Reabrir hilo"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'open'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Asunto del hilo…" readonly="state == 'closed'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Participantes">
                            <field name="participant_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   readonly="state == 'closed'"
                                   domain="[('share', '=', False)]"
                                   placeholder="Añade otros participantes (tú ya estás incluido)…"/>
                            <field name="creator_id" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Mensaje inicial"/>
                    <field name="description"
                           nolabel="1"
                           placeholder="Escribe aquí el contexto o la pregunta inicial para que todos los participantes tengan contexto…"
                           readonly="state == 'closed'"
                           style="min-height: 160px;"/>
                </sheet>
                <!-- Chatter: aquí se produce toda la conversación posterior al mensaje inicial -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- BÚSQUEDA                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="view_message_thread_search" model="ir.ui.view">
        <field name="name">aula_metrics.message_thread.search</field>
        <field name="model">aula_metrics.message_thread</field>
        <field name="arch" type="xml">
            <search string="Buscar comunicaciones">
                <field name="name" string="Asunto"/>
                <field name="participant_ids" string="Participante"/>
                <field name="creator_id" string="Iniciado por"/>
                <separator/>
                <filter name="filter_open"   string="Activos"  domain="[('state', '=', 'open')]"/>
                <filter name="filter_closed" string="Cerrados" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="filter_mine"
                        string="En los que participo"
                        domain="[('participant_ids', 'in', [uid])]"/>
                <filter name="filter_created_by_me"
                        string="Iniciados por mí"
                        domain="[('creator_id', '=', uid)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state"   string="Estado"      context="{'group_by': 'state'}"/>
                    <filter name="group_creator" string="Creado por"  context="{'group_by': 'creator_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ACCIÓN                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="action_message_thread" model="ir.actions.act_window">
        <field name="name">Comunicaciones Internas</field>
        <field name="res_model">aula_metrics.message_thread</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_message_thread_search"/>
        <field name="context">{'search_default_filter_open': 1, 'search_default_filter_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay ninguna comunicación activa
            </p>
            <p>
                Crea un hilo para coordinarte con otros tutores, orientadores o dirección.
            </p>
        </field>
    </record>

</odoo>
