<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista de Alertas -->
    <record id="view_alert_tree" model="ir.ui.view">
        <field name="name">aula_metrics.alert.tree</field>
        <field name="model">aula_metrics.alert</field>
        <field name="arch" type="xml">
            <tree string="Alertas">
                <field name="name"/>
                <field name="alert_type"/>
                <field name="alert_date"/>
                <field name="status"/>
                <field name="alert_level"/>
                <field name="threshold_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Vista de Formulario de Alertas -->
    <record id="view_alert_form" model="ir.ui.view">
        <field name="name">aula_metrics.alert.form</field>
        <field name="model">aula_metrics.alert</field>
        <field name="arch" type="xml">
            <form string="Alerta">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="alert_date" readonly="1"/>
                        <field name="status" widget="badge"
                               decoration-success="status == 'active'"
                               decoration-info="status == 'en_gestion'"
                               decoration-secondary="status in ('resolved', 'dismissed')"/>
                        <field name="alert_level" readonly="1"/>
                        <field name="alert_type" readonly="1"/>
                        <field name="threshold_id" readonly="1" invisible="alert_type == 'qualitative'"/>
                        <field name="severity"/>
                    </group>
                    <group>
                        <field name="message" readonly="1"/>
                        <field name="score_value" readonly="1" string="Valor" 
                               help="Para alertas cuantitativas: valor de la métrica. Para cualitativas: número de palabras clave detectadas."/>
                    </group>
                    <group string="Origen">
                        <field name="participation_id" readonly="1" invisible="alert_type != 'quantitative'"/>
                        <field name="qualitative_response_id" readonly="1" invisible="alert_type != 'qualitative'"/>
                        <field name="student_id" readonly="1"/>
                        <field name="academic_group_id" readonly="1"/>
                    </group>
                    <!-- Descripción del tutor: solo visible para alertas manuales -->
                    <group string="Descripción del Tutor" invisible="alert_type != 'manual'">
                        <field name="manual_description" readonly="1" widget="text" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Resolución" invisible="status != 'resolved'">
                        <field name="resolution_date" readonly="1"/>
                        <field name="resolution_action" readonly="1" widget="text" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana para Alertas -->
    <record id="action_alert" model="ir.actions.act_window">
        <field name="name">Alertas</field>
        <field name="res_model">aula_metrics.alert</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay alertas generadas
            </p>
            <p>
                Las alertas se generan automáticamente según los umbrales configurados.
            </p>
        </field>
    </record>
</odoo>