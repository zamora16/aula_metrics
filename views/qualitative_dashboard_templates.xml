<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         QUALITATIVE DASHBOARD — Full page (standalone route)
         Values expected: css_styles, role_desc, evaluations, questions,
                          evaluation_id, question_id, view_type,
                          + role-specific keys (see sub-templates below)
         ===================================================================== -->
    <template id="qualitative_dashboard_full" name="AulaMetrics - Dashboard Cualitativo">
        <html lang="es">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Análisis Cualitativo - AulaMetrics</title>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/d3-cloud/1.2.7/d3.layout.cloud.min.js"/>
                <t t-out="css_styles"/>
            </head>
            <body>
                <div class="dashboard-header">
                    <div>
                        <div class="header-title">
                            <h2>
                                <i class="fa-solid fa-comments me-2 text-primary"/>
                                Análisis Cualitativo
                            </h2>
                        </div>
                        <div class="header-meta"><t t-out="role_desc"/></div>
                    </div>
                </div>

                <div class="container-fluid">
                    <t t-call="aula_metrics.qualitative_filter_form"/>
                    <t t-call="aula_metrics.qualitative_role_content"/>
                </div>
            </body>
        </html>
    </template>


    <!-- =====================================================================
         QUALITATIVE DASHBOARD — Embedded fragment (no HTML wrapper)
         Same values as full page.
         ===================================================================== -->
    <template id="qualitative_dashboard_embedded" name="AulaMetrics - Dashboard Cualitativo Embebido">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"/>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/d3-cloud/1.2.7/d3.layout.cloud.min.js"/>
        <t t-out="css_styles"/>

        <div class="container-fluid mt-4">
            <div class="row mb-3">
                <div class="col-12">
                    <p class="text-muted" style="font-size:14px; margin-bottom:16px;">
                        <t t-out="role_desc"/>
                    </p>
                </div>
            </div>
            <t t-call="aula_metrics.qualitative_filter_form"/>
            <t t-call="aula_metrics.qualitative_role_content"/>
        </div>
    </template>


    <!-- =====================================================================
         SHARED: Filter form
         Values: evaluations, questions, available_levels, available_groups,
                 evaluation_id, question_id, course_level, group_id, role
         ===================================================================== -->
    <template id="qualitative_filter_form" name="AulaMetrics - Filtros Cualitativos">
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <form method="get"
                              action="/aulametrics/qualitative/dashboard"
                              class="row g-3"
                              id="qualitativeFiltersForm">

                            <!-- Evaluación: siempre visible; col más estrecho cuando hay filtros extra -->
                            <div t-att-class="'col-md-3' if (role in ['counselor', 'admin'] and available_levels) else 'col-md-5'">
                                <label class="form-label" for="qEvalSelect">Evaluación</label>
                                <select id="qEvalSelect" name="evaluation_id" class="form-select">
                                    <option value="">Todas las evaluaciones</option>
                                    <t t-foreach="evaluations" t-as="ev">
                                        <option t-att-value="ev.id"
                                                t-att-selected="'selected' if evaluation_id == ev.id else None">
                                            <t t-out="ev.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!-- Pregunta: siempre visible; col más estrecho cuando hay filtros extra -->
                            <div t-att-class="'col-md-3' if (role in ['counselor', 'admin'] and available_levels) else 'col-md-5'">
                                <label class="form-label" for="qQuestionSelect">Pregunta</label>
                                <select id="qQuestionSelect" name="question_id" class="form-select">
                                    <option value="">Todas las preguntas</option>
                                    <t t-foreach="questions" t-as="q">
                                        <option t-att-value="q.id"
                                                t-att-selected="'selected' if question_id == q.id else None">
                                            <t t-out="q.title[:80]"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!-- Nivel educativo: counselor/admin/management cuando hay datos -->
                            <t t-if="role != 'tutor' and available_levels">
                                <div class="col-md-2">
                                    <label class="form-label" for="qLevelSelect">Nivel</label>
                                    <select id="qLevelSelect" name="course_level" class="form-select">
                                        <option value="">Todos los niveles</option>
                                        <t t-foreach="available_levels" t-as="lv">
                                            <option t-att-value="lv[0]"
                                                    t-att-selected="'selected' if course_level == lv[0] else None">
                                                <t t-out="lv[1]"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </t>

                            <!-- Grupo concreto: solo counselor/admin; cascade JS filtra por nivel -->
                            <t t-if="role in ['counselor', 'admin'] and available_groups">
                                <div class="col-md-2">
                                    <label class="form-label">Grupo</label>
                                    <select id="amGroupSelect" name="group_id" class="form-select">
                                        <option value="">Todos los grupos</option>
                                        <t t-foreach="available_groups" t-as="grp">
                                            <option t-att-value="grp.id"
                                                    t-att-data-level="grp.course_level"
                                                    t-att-selected="'selected' if group_id == grp.id else None">
                                                <t t-out="grp.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </t>

                            <!-- JS: cascade nivel → grupo en tiempo real -->
                            <t t-if="role in ['counselor', 'admin'] and available_groups">
                                <script>
                                (function() {
                                    function cascadeGroups() {
                                        var levelSel = document.querySelector('[name="course_level"]');
                                        var groupSel = document.getElementById('amGroupSelect');
                                        if (!levelSel || !groupSel) return;

                                        var selectedLevel = levelSel.value;
                                        var opts = groupSel.querySelectorAll('option[data-level]');

                                        opts.forEach(function(opt) {
                                            var match = !selectedLevel || opt.dataset.level === selectedLevel;
                                            opt.hidden = !match;
                                            // Reset selection if current choice no longer matches
                                            if (!match &amp;&amp; opt.selected) {
                                                opt.selected = false;
                                                groupSel.value = '';
                                            }
                                        });
                                    }

                                    function init() {
                                        var levelSel = document.querySelector('[name="course_level"]');
                                        if (levelSel) {
                                            levelSel.addEventListener('change', cascadeGroups);
                                            // Apply immediately in case level is pre-selected
                                            cascadeGroups();
                                        }
                                    }

                                    if (document.readyState === 'loading') {
                                        document.addEventListener('DOMContentLoaded', init);
                                    } else {
                                        init();
                                    }
                                })();
                                </script>
                            </t>

                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                            </div>

                        </form>

                        <!-- Indicador de filtros activos de segmentación -->
                        <t t-if="course_level or group_id">
                            <div style="margin-top:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                <span style="font-size:11px;font-weight:700;text-transform:uppercase;
                                             letter-spacing:0.07em;color:var(--am-muted);">Filtrando por</span>
                                <t t-if="course_level">
                                    <t t-foreach="available_levels" t-as="lv">
                                        <t t-if="lv[0] == course_level">
                                            <span style="display:inline-flex;align-items:center;gap:5px;
                                                         padding:3px 10px;border-radius:20px;font-size:12px;
                                                         font-weight:600;background:var(--am-light);
                                                         border:1px solid var(--am-border);color:var(--am-text);">
                                                <i class="fa-solid fa-layer-group" style="font-size:10px;color:var(--am-muted);"/>
                                                <t t-out="lv[1]"/>
                                            </span>
                                        </t>
                                    </t>
                                </t>
                                <t t-if="group_id">
                                    <t t-foreach="available_groups" t-as="grp">
                                        <t t-if="grp.id == group_id">
                                            <span style="display:inline-flex;align-items:center;gap:5px;
                                                         padding:3px 10px;border-radius:20px;font-size:12px;
                                                         font-weight:600;background:var(--am-light);
                                                         border:1px solid var(--am-border);color:var(--am-text);">
                                                <i class="fa-solid fa-users" style="font-size:10px;color:var(--am-muted);"/>
                                                <t t-out="grp.name"/>
                                            </span>
                                        </t>
                                    </t>
                                </t>
                                <a href="/aulametrics/qualitative/dashboard"
                                   style="font-size:11px;color:var(--am-muted);text-decoration:none;margin-left:4px;"
                                   t-attf-href="/aulametrics/qualitative/dashboard?evaluation_id=#{evaluation_id or ''}&amp;question_id=#{question_id or ''}">
                                    Quitar filtros
                                </a>
                            </div>
                        </t>

                    </div>
                </div>
            </div>
        </div>
    </template>


    <!-- =====================================================================
         SHARED: Content dispatcher by role
         ===================================================================== -->
    <template id="qualitative_role_content" name="AulaMetrics - Contenido por Rol">
        <t t-if="view_type == 'counselor'">
            <t t-call="aula_metrics.qualitative_counselor_view"/>
        </t>
        <t t-elif="view_type == 'tutor'">
            <t t-call="aula_metrics.qualitative_tutor_view"/>
        </t>
        <t t-else="">
            <t t-call="aula_metrics.qualitative_management_view"/>
        </t>
    </template>


    <!-- =====================================================================
         COUNSELOR VIEW
         Extra values: total_responses, responses_with_alerts,
                       responses (list of dicts), wordcloud_json, palette_json
         ===================================================================== -->
    <template id="qualitative_counselor_view" name="AulaMetrics - Vista Counselor">

        <!-- KPI Cards -->
        <div class="kpi-container">
            <div class="kpi-card">
                <div class="kpi-label">Total Respuestas</div>
                <div class="kpi-value"><t t-out="total_responses"/></div>
                <div class="kpi-description">Respuestas recibidas</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Con Alertas</div>
                <div class="kpi-value"><t t-out="responses_with_alerts"/></div>
                <div class="kpi-description">Requieren atención</div>
            </div>
        </div>

        <div class="row">
            <!-- Wordcloud: altura dinámica, oculto si no hay palabras -->
            <div class="col-12 mb-4">
                <div style="border:1px solid var(--am-border);border-radius:10px;
                            background:var(--am-surface);overflow:hidden;">
                    <div style="padding:12px 18px;border-bottom:1px solid var(--am-border);
                                display:flex;align-items:center;gap:8px;">
                        <i class="fa-solid fa-wind" style="color:var(--am-muted);font-size:12px;"/>
                        <span style="font-size:13px;font-weight:600;color:var(--am-text);">Nube de Palabras</span>
                    </div>
                    <div style="padding:12px 18px;">
                        <div id="wordcloud" style="width:100%;"/>
                    </div>
                </div>
            </div>

            <!-- Responses table -->
            <div class="col-12">
                <div style="border:1px solid var(--am-border);border-radius:10px;
                            background:var(--am-surface);overflow:hidden;">
                    <div style="padding:12px 18px;border-bottom:1px solid var(--am-border);
                                display:flex;align-items:center;justify-content:space-between;">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <i class="fa-solid fa-align-left" style="color:var(--am-muted);font-size:12px;"/>
                            <span style="font-size:13px;font-weight:600;color:var(--am-text);">Respuestas</span>
                        </div>
                        <span style="font-size:12px;color:var(--am-muted);">
                            <t t-out="total_responses"/>
                            <t t-if="total_responses == 1"> respuesta</t>
                            <t t-else=""> respuestas</t>
                        </span>
                    </div>
                    <t t-if="not responses">
                        <div style="padding:32px;text-align:center;font-size:13px;color:var(--am-muted);">
                            No hay respuestas con los filtros actuales.
                        </div>
                    </t>
                    <t t-else="">
                        <div style="overflow-x:auto;">
                            <table style="width:100%;border-collapse:collapse;">
                                <thead>
                                    <tr style="background:var(--am-light);">
                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);text-align:left;
                                                   border-bottom:1px solid var(--am-border);">Alumno</th>
                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);text-align:left;
                                                   border-bottom:1px solid var(--am-border);">Grupo</th>
                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);white-space:nowrap;text-align:left;
                                                   border-bottom:1px solid var(--am-border);">Fecha</th>
                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);text-align:left;
                                                   border-bottom:1px solid var(--am-border);">Respuesta</th>
                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);text-align:center;white-space:nowrap;
                                                   border-bottom:1px solid var(--am-border);">Palabras</th>
                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);text-align:center;
                                                   border-bottom:1px solid var(--am-border);">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="responses" t-as="resp">
                                        <tr t-att-style="'border-left:3px solid #f87171;border-bottom:1px solid var(--am-border);' if resp['has_alerts'] else 'border-left:3px solid transparent;border-bottom:1px solid var(--am-border);'"
                                            onmouseover="this.style.background='var(--am-light)'"
                                            onmouseout="this.style.background=''">
                                            <td style="padding:12px 16px;vertical-align:middle;">
                                                <a t-attf-href="/aulametrics/student/#{resp['student_id']}"
                                                   style="font-size:13px;font-weight:600;
                                                          color:var(--am-primary);text-decoration:none;"
                                                   onmouseover="this.style.textDecoration='underline'"
                                                   onmouseout="this.style.textDecoration='none'">
                                                    <t t-out="resp['student_name']"/>
                                                </a>
                                            </td>
                                            <td style="padding:12px 16px;vertical-align:middle;">
                                                <span style="display:inline-block;padding:2px 8px;
                                                             border-radius:12px;font-size:11px;font-weight:600;
                                                             background:var(--am-light);border:1px solid var(--am-border);
                                                             color:var(--am-muted);white-space:nowrap;">
                                                    <t t-out="resp['group_name']"/>
                                                </span>
                                            </td>
                                            <td style="padding:12px 16px;vertical-align:middle;
                                                       font-size:12px;color:var(--am-muted);white-space:nowrap;">
                                                <t t-out="resp['date']"/>
                                            </td>
                                            <td style="padding:12px 16px;vertical-align:middle;
                                                       font-size:13px;color:var(--am-text);
                                                       line-height:1.55;max-width:400px;">
                                                <t t-if="len(resp['response'] or '') &gt; 150">
                                                    <t t-out="resp['response'][:150]"/>...
                                                    <a href="#"
                                                       style="font-size:12px;color:var(--am-muted);
                                                              text-decoration:none;font-weight:600;margin-left:4px;"
                                                       t-attf-onclick="alert('#{resp['response'][:300].replace(&quot;'&quot;, &quot;\\'&quot;)}...'); return false;">
                                                        Ver más
                                                    </a>
                                                </t>
                                                <t t-else="">
                                                    <t t-out="resp['response']"/>
                                                </t>
                                            </td>
                                            <td style="padding:12px 16px;vertical-align:middle;
                                                       text-align:center;font-size:13px;font-weight:600;
                                                       color:var(--am-text);">
                                                <t t-out="resp['word_count']"/>
                                            </td>
                                            <td style="padding:12px 16px;vertical-align:middle;text-align:center;">
                                                <t t-if="resp['has_alerts']">
                                                    <span style="display:inline-block;padding:3px 10px;
                                                                 border-radius:20px;font-size:11px;font-weight:700;
                                                                 background:#fef2f2;border:1px solid #fecaca;
                                                                 color:#dc2626;white-space:nowrap;">
                                                        Alerta
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span style="display:inline-block;padding:3px 10px;
                                                                 border-radius:20px;font-size:11px;font-weight:700;
                                                                 background:#f0fdf4;border:1px solid #bbf7d0;
                                                                 color:#16a34a;white-space:nowrap;">
                                                        OK
                                                    </span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </div>
        </div>

        <script>
            (function() {
                var wordcloudData = <t t-out="wordcloud_json"/>;
                var paletteColors = <t t-out="palette_json"/>;

                function initWordcloud() {
                    var el = document.getElementById('wordcloud');
                    if (!el) return;
                    if (!wordcloudData || wordcloudData.length === 0) {
                        el.innerHTML = '<div style="text-align:center;padding:24px;font-size:13px;color:#94a3b8;">No hay suficientes palabras para generar la nube</div>';
                        return;
                    }
                    // Altura dinámica: escala con nº de palabras (mín 140px, máx 280px)
                    var h = Math.min(280, Math.max(140, wordcloudData.length * 9));
                    el.style.height = h + 'px';

                    var words = wordcloudData.map(function(d) {
                        return {text: d[0], size: Math.sqrt(d[1]) * 10 + 11};
                    });

                    var layout = d3.layout.cloud()
                        .size([el.offsetWidth || 800, h])
                        .words(words)
                        .padding(6)
                        .rotate(function() { return ~~(Math.random() * 2) * 90; })
                        .font("Plus Jakarta Sans")
                        .fontSize(function(d) { return d.size; })
                        .on("end", function(words) {
                            d3.select("#wordcloud").append("svg")
                                .attr("width", layout.size()[0])
                                .attr("height", layout.size()[1])
                                .append("g")
                                .attr("transform", "translate(" + layout.size()[0] / 2 + "," + layout.size()[1] / 2 + ")")
                                .selectAll("text")
                                .data(words)
                                .enter().append("text")
                                .style("font-size", function(d) { return d.size + "px"; })
                                .style("font-family", "Plus Jakarta Sans")
                                .style("font-weight", "700")
                                .style("fill", function(d, i) { return paletteColors[i % paletteColors.length]; })
                                .attr("text-anchor", "middle")
                                .attr("transform", function(d) {
                                    return "translate(" + [d.x, d.y] + ")rotate(" + d.rotate + ")";
                                })
                                .text(function(d) { return d.text; });
                        });
                    layout.start();
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initWordcloud);
                } else {
                    setTimeout(initWordcloud, 100);
                }
            })();
        </script>
    </template>


    <!-- =====================================================================
         TUTOR VIEW
         Extra values: stats (dict), anonymous_responses (list of dicts),
                       wordcloud_json, palette_json
         ===================================================================== -->
    <template id="qualitative_tutor_view" name="AulaMetrics - Vista Tutor">

        <!-- KPI Cards -->
        <div class="kpi-container">
            <div class="kpi-card">
                <div class="kpi-label">Total Respuestas</div>
                <div class="kpi-value"><t t-out="stats.get('total_responses', 0)"/></div>
                <div class="kpi-description">De tu grupo</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Longitud Media</div>
                <div class="kpi-value"><t t-out="stats.get('avg_length', 0)"/></div>
                <div class="kpi-description">Palabras promedio</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Con Alertas</div>
                <div class="kpi-value"><t t-out="stats.get('responses_with_alerts', 0)"/></div>
                <div class="kpi-description">Requieren atención</div>
            </div>
        </div>

        <div class="row">
            <!-- Top words -->
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Palabras Frecuentes</h5>
                    </div>
                    <div class="card-body">
                        <ol>
                            <t t-foreach="stats.get('top_words', [])[:5]" t-as="w">
                                <li>
                                    <strong><t t-out="w[0]"/></strong>
                                    (<t t-out="w[1]"/> veces)
                                </li>
                            </t>
                        </ol>
                    </div>
                </div>
            </div>

            <!-- Wordcloud -->
            <div class="col-md-8 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Nube de Palabras</h5>
                    </div>
                    <div class="card-body">
                        <div id="wordcloud" style="width:100%; height:350px;"/>
                    </div>
                </div>
            </div>

            <!-- Anonymous responses -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Respuestas Anónimas</h5>
                    </div>
                    <div class="card-body">
                        <t t-if="not anonymous_responses">
                            <p class="text-center text-muted py-4">
                                No hay respuestas cualitativas.
                            </p>
                        </t>
                        <t t-foreach="anonymous_responses" t-as="resp">
                            <div t-attf-class="mb-3 p-3 bg-light rounded border #{'border-warning' if resp['has_alerts'] else ''}">
                                <div class="d-flex justify-content-between mb-2">
                                    <small class="text-muted">
                                        <t t-out="resp['date']"/> | <t t-out="resp['word_count']"/> palabras
                                    </small>
                                    <t t-if="resp['has_alerts']">
                                        <span class="badge bg-warning">Alerta</span>
                                    </t>
                                </div>
                                <p class="mb-0"><t t-out="resp['response']"/></p>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>

        <script>
            (function() {
                var wordcloudData = <t t-out="wordcloud_json"/>;
                var paletteColors = <t t-out="palette_json"/>;

                function initWordcloud() {
                    if (!wordcloudData || wordcloudData.length === 0) {
                        var el = document.getElementById('wordcloud');
                        if (el) el.innerHTML = '<div style="text-align:center; padding:40px; color:#94a3b8;">No hay suficientes palabras para generar la nube</div>';
                        return;
                    }
                    var wordcloudEl = document.getElementById('wordcloud');
                    if (!wordcloudEl) return;

                    var words = wordcloudData.map(function(d) { return {text: d[0], size: Math.sqrt(d[1]) * 10 + 10}; });

                    var layout = d3.layout.cloud()
                        .size([wordcloudEl.offsetWidth || 800, 350])
                        .words(words)
                        .padding(5)
                        .rotate(function() { return ~~(Math.random() * 2) * 90; })
                        .font("Inter")
                        .fontSize(function(d) { return d.size; })
                        .on("end", function(words) {
                            d3.select("#wordcloud").append("svg")
                                .attr("width", layout.size()[0])
                                .attr("height", layout.size()[1])
                                .append("g")
                                .attr("transform", "translate(" + layout.size()[0] / 2 + "," + layout.size()[1] / 2 + ")")
                                .selectAll("text")
                                .data(words)
                                .enter().append("text")
                                .style("font-size", function(d) { return d.size + "px"; })
                                .style("font-family", "Inter")
                                .style("fill", function(d, i) { return paletteColors[i % paletteColors.length]; })
                                .attr("text-anchor", "middle")
                                .attr("transform", function(d) { return "translate(" + [d.x, d.y] + ")rotate(" + d.rotate + ")"; })
                                .text(function(d) { return d.text; });
                        });
                    layout.start();
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initWordcloud);
                } else {
                    setTimeout(initWordcloud, 100);
                }
            })();
        </script>
    </template>


    <!-- =====================================================================
         MANAGEMENT VIEW
         Extra values: total_responses, stats_by_course (dict of dicts)
         ===================================================================== -->
    <template id="qualitative_management_view" name="AulaMetrics - Vista Management">
        <div class="row">
            <div class="col-12 mb-4">
                <div class="alert alert-info">
                    <h5 class="alert-heading">Vista Agregada de Privacidad</h5>
                    <p class="mb-0">
                        Solo se muestran estadísticas agregadas por curso
                        para proteger la privacidad de los estudiantes.
                    </p>
                </div>
            </div>

            <div class="col-12 mb-4">
                <div class="kpi-card">
                    <div class="kpi-label">Total de Respuestas en el Centro</div>
                    <div class="kpi-value"><t t-out="total_responses"/></div>
                    <div class="kpi-description">Respuestas cualitativas recibidas</div>
                </div>
            </div>

            <t t-if="not stats_by_course">
                <div class="col-12">
                    <p class="text-center text-muted py-5">
                        No hay respuestas disponibles.
                    </p>
                </div>
            </t>

            <t t-foreach="stats_by_course.items()" t-as="course_item">
                <t t-set="course_name" t-value="course_item[0]"/>
                <t t-set="course_stats" t-value="course_item[1]"/>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title mb-0"><t t-out="course_name"/></h5>
                        </div>
                        <div class="card-body">
                            <div class="kpi-value"><t t-out="course_stats.get('total_responses', 0)"/></div>
                            <div class="kpi-label mb-3">Respuestas totales</div>
                            <p class="mb-2">
                                <strong>Longitud media:</strong>
                                <t t-out="course_stats.get('avg_length', 0)"/> palabras
                            </p>
                            <p class="mb-3">
                                <strong>Con alertas:</strong>
                                <t t-out="course_stats.get('responses_with_alerts', 0)"/>
                            </p>
                            <hr/>
                            <h6>Palabras frecuentes:</h6>
                            <ol class="small">
                                <t t-foreach="course_stats.get('top_words', [])[:5]" t-as="w">
                                    <li><strong><t t-out="w[0]"/></strong> (<t t-out="w[1]"/>)</li>
                                </t>
                            </ol>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>

</odoo>
