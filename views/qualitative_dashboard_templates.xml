<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         QUALITATIVE DASHBOARD — Full page (standalone route)
         Values expected: css_styles, role_desc, evaluations, questions,
                          selected_evals, question_id, view_type,
                          + role-specific keys (see sub-templates below)
         ===================================================================== -->
    <template id="qualitative_dashboard_full" name="AulaMetrics - Dashboard Cualitativo">
        <html lang="es">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Análisis Cualitativo - AulaMetrics</title>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
                      rel="stylesheet"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/d3-cloud/1.2.7/d3.layout.cloud.min.js"/>
                <t t-out="css_styles"/>
            </head>
            <body>
                <div class="dashboard-layout">
                    <t t-call="aula_metrics.dashboard_sidebar"/>
                    <main class="main-content">
                        <div class="dashboard-header">
                            <div>
                                <div class="header-title">
                                    <h2>
                                        <i class="fa-solid fa-comments me-2 text-primary" aria-hidden="true"/>
                                        Análisis Cualitativo
                                    </h2>
                                </div>
                            </div>
                        </div>
                        <div class="container-fluid">
                            <t t-call="aula_metrics.qualitative_filter_form"/>
                            <t t-call="aula_metrics.qualitative_role_content"/>
                        </div>
                    </main>
                </div>
            </body>
        </html>
    </template>


    <!-- =====================================================================
         QUALITATIVE DASHBOARD — Embedded fragment (no HTML wrapper)
         Same values as full page.
         ===================================================================== -->
    <template id="qualitative_dashboard_embedded" name="AulaMetrics - Dashboard Cualitativo Embebido">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"/>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/d3-cloud/1.2.7/d3.layout.cloud.min.js"/>
        <t t-out="css_styles"/>

        <div class="container-fluid">
            <t t-call="aula_metrics.qualitative_filter_form"/>
            <t t-call="aula_metrics.qualitative_role_content"/>
        </div>
    </template>


    <!-- =====================================================================
         SHARED: Filter form
         Values: evaluations, questions, available_levels, available_groups,
                 selected_evals, question_id, course_level, group_id, role
         ===================================================================== -->
    <template id="qualitative_filter_form" name="AulaMetrics - Filtros Cualitativos">
        <div class="filter-panel-compact">
            <form method="get"
                  action="/aulametrics/qualitative/dashboard"
                  id="qualitativeFiltersForm">
                <div class="filter-header">
                    <i class="fa-solid fa-filter" aria-hidden="true"/>
                    <span>Filtrar por Evaluaciones</span>
                </div>
                <div class="filter-pills-container" role="group" aria-label="Filtrar por evaluación">
                    <t t-foreach="evaluations" t-as="ev">
                        <t t-set="is_active" t-value="(selected_evals and ev.id in selected_evals) or not selected_evals"/>
                        <button type="button"
                                t-att-class="'filter-pill eval-pill' + (' active' if is_active else '')"
                                role="checkbox"
                                t-att-aria-checked="'true' if is_active else 'false'"
                                t-att-data-value="ev.id"
                                onclick="togglePill(this)">
                            <t t-out="ev.name"/>
                        </button>
                    </t>
                </div>
                <div class="filter-actions">
                    <button type="button" class="btn-filter-action" onclick="selectAllPillsInForm(this.closest('form'))">
                        <i class="fa-solid fa-check-double me-1" aria-hidden="true"/>Todas
                    </button>
                    <button type="submit" class="btn-filter-action btn-filter-primary">
                        <i class="fa-solid fa-magnifying-glass me-1" aria-hidden="true"/>Aplicar Filtros
                    </button>
                </div>
            </form>
        </div>
    </template>


    <!-- =====================================================================
         SHARED: Content dispatcher by role
         ===================================================================== -->
    <template id="qualitative_role_content" name="AulaMetrics - Contenido por Rol">
        <t t-if="view_type == 'counselor'">
            <t t-call="aula_metrics.qualitative_counselor_view"/>
        </t>
        <t t-elif="view_type == 'tutor'">
            <t t-call="aula_metrics.qualitative_tutor_view"/>
        </t>
        <t t-else="">
            <t t-call="aula_metrics.qualitative_management_view"/>
        </t>
    </template>


    <!-- =====================================================================
         COUNSELOR VIEW
         Extra values: total_responses, responses_with_alerts,
                       responses (list of dicts), wordcloud_json, palette_json
         ===================================================================== -->
    <template id="qualitative_counselor_view" name="AulaMetrics - Vista Counselor">

        <!-- KPI Cards -->
        <div class="kpi-container">
            <div class="kpi-card">
                <div class="kpi-label">Total Respuestas</div>
                <div class="kpi-value"><t t-out="total_responses"/></div>
                <div class="kpi-description">Respuestas recibidas</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Con Alertas</div>
                <div class="kpi-value"><t t-out="responses_with_alerts"/></div>
                <div class="kpi-description">Requieren atención</div>
            </div>
        </div>

        <!-- Nubes de palabras: una por binomio Evaluación+Pregunta -->
        <t t-if="wordclouds">
            <!-- 1 nube → centrada a 8/12; 2+ nubes → grid de 2 columnas -->
            <div t-att-class="'row justify-content-center' if len(wordclouds) == 1 else 'row'">
                <t t-foreach="wordclouds" t-as="wc">
                    <div t-att-class="'col-xl-8 col-lg-10 col-12 mb-4' if len(wordclouds) == 1 else 'col-md-6 col-12 mb-4'">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <h5 class="card-title mb-0" style="font-size:13px;">
                                        <i class="fa-solid fa-wind me-2" style="color:var(--am-muted);font-size:11px;"/>
                                        <t t-out="wc['question_title']"/>
                                    </h5>
                                    <div style="font-size:11px;color:var(--am-muted);margin-top:3px;">
                                        <i class="fa-regular fa-calendar me-1"/>
                                        <t t-out="wc['eval_name']"/>
                                        <span style="margin-left:8px;color:var(--am-subtle);">
                                            · <t t-out="wc['count']"/> respuestas
                                        </span>
                                    </div>
                                </div>
                                <t t-if="len(wc['groups']) > 1">
                                    <select class="form-select form-select-sm am-wc-group-select"
                                            t-att-data-wc-id="wc['id']"
                                            style="width:auto;min-width:140px;font-size:12px;flex-shrink:0;">
                                        <option value="">Todos los grupos</option>
                                        <t t-foreach="wc['groups']" t-as="grp">
                                            <option t-att-value="grp['id']"><t t-out="grp['name']"/></option>
                                        </t>
                                    </select>
                                </t>
                            </div>
                            <div class="card-body">
                                <div t-att-id="wc['id']" style="width:100%;"/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>

            <!-- Responses table -->
            <div class="row">
            <div class="col-12">
                <div style="border:1px solid var(--am-border);border-radius:10px;
                            background:var(--am-surface);overflow:hidden;">
                    <div style="padding:12px 18px;border-bottom:1px solid var(--am-border);
                                display:flex;align-items:center;justify-content:space-between;">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <i class="fa-solid fa-align-left" style="color:var(--am-muted);font-size:12px;"/>
                            <span style="font-size:13px;font-weight:600;color:var(--am-text);">Respuestas</span>
                        </div>
                        <span style="font-size:12px;color:var(--am-muted);">
                            <t t-out="total_responses"/>
                            <t t-if="total_responses == 1"> respuesta</t>
                            <t t-else=""> respuestas</t>
                        </span>
                    </div>
                    <t t-if="not responses">
                        <div style="padding:32px;text-align:center;font-size:13px;color:var(--am-muted);">
                            No hay respuestas con los filtros actuales.
                        </div>
                    </t>
                    <t t-else="">
                        <div style="overflow-x:auto;">
                            <table style="width:100%;border-collapse:collapse;">
                                <thead>
                                    <tr style="background:var(--am-light);">
                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);text-align:left;
                                                   border-bottom:1px solid var(--am-border);">Alumno</th>
                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);text-align:left;
                                                   border-bottom:1px solid var(--am-border);">Grupo</th>
                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);white-space:nowrap;text-align:left;
                                                   border-bottom:1px solid var(--am-border);">Fecha</th>
                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);text-align:left;
                                                   border-bottom:1px solid var(--am-border);">Respuesta</th>

                                        <th style="padding:10px 16px;font-size:11px;font-weight:700;
                                                   text-transform:uppercase;letter-spacing:0.07em;
                                                   color:var(--am-muted);text-align:center;
                                                   border-bottom:1px solid var(--am-border);">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="responses" t-as="resp">
                                        <tr t-att-style="'border-left:3px solid #f87171;border-bottom:1px solid var(--am-border);' if resp['has_alerts'] else 'border-left:3px solid transparent;border-bottom:1px solid var(--am-border);'"
                                            onmouseover="this.style.background='var(--am-light)'"
                                            onmouseout="this.style.background=''">
                                            <td style="padding:12px 16px;vertical-align:middle;">
                                                <a t-attf-href="/aulametrics/student/#{resp['student_id']}"
                                                   style="font-size:13px;font-weight:600;
                                                          color:var(--am-primary);text-decoration:none;"
                                                   onmouseover="this.style.textDecoration='underline'"
                                                   onmouseout="this.style.textDecoration='none'">
                                                    <t t-out="resp['student_name']"/>
                                                </a>
                                            </td>
                                            <td style="padding:12px 16px;vertical-align:middle;">
                                                <span style="display:inline-block;padding:2px 8px;
                                                             border-radius:12px;font-size:11px;font-weight:600;
                                                             background:var(--am-light);border:1px solid var(--am-border);
                                                             color:var(--am-muted);white-space:nowrap;">
                                                    <t t-out="resp['group_name']"/>
                                                </span>
                                            </td>
                                            <td style="padding:12px 16px;vertical-align:middle;
                                                       font-size:12px;color:var(--am-muted);white-space:nowrap;">
                                                <t t-out="resp['date']"/>
                                            </td>
                                            <td style="padding:12px 16px;vertical-align:middle;
                                                       font-size:13px;color:var(--am-text);
                                                       line-height:1.55;max-width:400px;">
                                                <t t-if="len(resp['response'] or '') &gt; 150">
                                                    <t t-out="resp['response'][:150]"/>...
                                                    <a href="#"
                                                       style="font-size:12px;color:var(--am-muted);
                                                              text-decoration:none;font-weight:600;margin-left:4px;"
                                                       t-attf-onclick="alert('#{resp['response'][:300].replace(&quot;'&quot;, &quot;\\'&quot;)}...'); return false;">
                                                        Ver más
                                                    </a>
                                                </t>
                                                <t t-else="">
                                                    <t t-out="resp['response']"/>
                                                </t>
                                            </td>

                                            <td style="padding:12px 16px;vertical-align:middle;text-align:center;">
                                                <t t-if="resp['has_alerts']">
                                                    <span style="display:inline-block;padding:3px 10px;
                                                                 border-radius:20px;font-size:11px;font-weight:700;
                                                                 background:#fef2f2;border:1px solid #fecaca;
                                                                 color:#dc2626;white-space:nowrap;">
                                                        Alerta
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span style="display:inline-block;padding:3px 10px;
                                                                 border-radius:20px;font-size:11px;font-weight:700;
                                                                 background:#f0fdf4;border:1px solid #bbf7d0;
                                                                 color:#16a34a;white-space:nowrap;">
                                                        OK
                                                    </span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
            </div>
            </div>

        <script>
            (function() {
                var _wc_palette = <t t-out="palette_json"/>;
                var _wc_list    = <t t-out="wordclouds_json"/>;
                function initAllWordclouds() {
                    _wc_list.forEach(function(wc) {
                        window.amWordcloud.init(wc.id, wc.data, _wc_palette);
                    });
                    document.querySelectorAll('.am-wc-group-select').forEach(function(sel) {
                        sel.addEventListener('change', function() {
                            var wcId = this.dataset.wcId;
                            var gid  = this.value;
                            var wc   = _wc_list.find(function(w) { return w.id === wcId; });
                            if (!wc) return;
                            var data = gid ? (wc.data_by_group[String(gid)] || []) : wc.data;
                            window.amWordcloud.init(wcId, data, _wc_palette);
                        });
                    });
                }
                window.initWordcloudCounselor = initAllWordclouds;
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initAllWordclouds);
                } else {
                    setTimeout(initAllWordclouds, 100);
                }
            })();
        </script>
    </template>



    <!-- =====================================================================
         TUTOR VIEW
         Extra values: stats (dict), anonymous_responses (list of dicts),
                       wordcloud_json, palette_json
         ===================================================================== -->
    <template id="qualitative_tutor_view" name="AulaMetrics - Vista Tutor">

        <!-- KPI Cards -->
        <div class="kpi-container">
            <div class="kpi-card">
                <div class="kpi-label">Total Respuestas</div>
                <div class="kpi-value"><t t-out="stats.get('total_responses', 0)"/></div>
                <div class="kpi-description">De tu grupo</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Longitud Media</div>
                <div class="kpi-value"><t t-out="stats.get('avg_length', 0)"/></div>
                <div class="kpi-description">Palabras promedio</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Con Alertas</div>
                <div class="kpi-value"><t t-out="stats.get('responses_with_alerts', 0)"/></div>
                <div class="kpi-description">Requieren atención</div>
            </div>
        </div>

        <div class="row">
            <!-- Top words -->
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Palabras Frecuentes</h5>
                    </div>
                    <div class="card-body">
                        <ol>
                            <t t-foreach="stats.get('top_words', [])[:5]" t-as="w">
                                <li>
                                    <strong><t t-out="w[0]"/></strong>
                                    (<t t-out="w[1]"/> veces)
                                </li>
                            </t>
                        </ol>
                    </div>
                </div>
            </div>

            <!-- Wordcloud -->
            <div class="col-md-8 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Nube de Palabras</h5>
                    </div>
                    <div class="card-body">
                        <div id="wordcloud" style="width:100%; height:350px;"/>
                    </div>
                </div>
            </div>

            <!-- Anonymous responses -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Respuestas Anónimas</h5>
                    </div>
                    <div class="card-body">
                        <t t-if="not anonymous_responses">
                            <p class="text-center text-muted py-4">
                                No hay respuestas cualitativas.
                            </p>
                        </t>
                        <t t-foreach="anonymous_responses" t-as="resp">
                            <div t-attf-class="mb-3 p-3 bg-light rounded border #{'border-warning' if resp['has_alerts'] else ''}">
                                <div class="d-flex justify-content-between mb-2">
                                    <small class="text-muted">
                                        <t t-out="resp['date']"/> | <t t-out="resp['word_count']"/> palabras
                                    </small>
                                    <t t-if="resp['has_alerts']">
                                        <span class="badge bg-warning">Alerta</span>
                                    </t>
                                </div>
                                <p class="mb-0"><t t-out="resp['response']"/></p>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>

        <script>
            (function() {
                var _wc_data   = <t t-out="wordcloud_json"/>;
                var _wc_colors = <t t-out="palette_json"/>;
                function initWordcloudTutor() {
                    window.amWordcloud.init('wordcloud', _wc_data, _wc_colors, 350);
                }
                window.initWordcloudTutor = initWordcloudTutor;
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initWordcloudTutor);
                } else {
                    setTimeout(initWordcloudTutor, 100);
                }
            })();
        </script>
    </template>


    <!-- =====================================================================
         MANAGEMENT VIEW
         Extra values: total_responses, stats_by_course (dict of dicts)
         ===================================================================== -->
    <template id="qualitative_management_view" name="AulaMetrics - Vista Management">
        <div class="row">
            <div class="col-12 mb-4">
                <div class="alert alert-info">
                    <h5 class="alert-heading">Vista Agregada de Privacidad</h5>
                    <p class="mb-0">
                        Solo se muestran estadísticas agregadas por curso
                        para proteger la privacidad de los estudiantes.
                    </p>
                </div>
            </div>

            <div class="col-12 mb-4">
                <div class="kpi-card">
                    <div class="kpi-label">Total de Respuestas en el Centro</div>
                    <div class="kpi-value"><t t-out="total_responses"/></div>
                    <div class="kpi-description">Respuestas cualitativas recibidas</div>
                </div>
            </div>

            <t t-if="not stats_by_course">
                <div class="col-12">
                    <p class="text-center text-muted py-5">
                        No hay respuestas disponibles.
                    </p>
                </div>
            </t>

            <t t-foreach="stats_by_course.items()" t-as="course_item">
                <t t-set="course_name" t-value="course_item[0]"/>
                <t t-set="course_stats" t-value="course_item[1]"/>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h5 class="card-title mb-0"><t t-out="course_name"/></h5>
                        </div>
                        <div class="card-body">
                            <div class="kpi-value"><t t-out="course_stats.get('total_responses', 0)"/></div>
                            <div class="kpi-label mb-3">Respuestas totales</div>
                            <p class="mb-2">
                                <strong>Longitud media:</strong>
                                <t t-out="course_stats.get('avg_length', 0)"/> palabras
                            </p>
                            <p class="mb-3">
                                <strong>Con alertas:</strong>
                                <t t-out="course_stats.get('responses_with_alerts', 0)"/>
                            </p>
                            <hr/>
                            <h6>Palabras frecuentes:</h6>
                            <ol class="small">
                                <t t-foreach="course_stats.get('top_words', [])[:5]" t-as="w">
                                    <li><strong><t t-out="w[0]"/></strong> (<t t-out="w[1]"/>)</li>
                                </t>
                            </ol>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>

</odoo>
