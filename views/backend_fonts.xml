<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="aula_metrics_backend_fonts"
              inherit_id="web.webclient_bootstrap"
              name="AulaMetrics Google Fonts">
        <xpath expr="//link[@rel='apple-touch-icon']" position="after">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&amp;family=Source+Sans+3:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap"/>
        </xpath>
    </template>
</odoo>
